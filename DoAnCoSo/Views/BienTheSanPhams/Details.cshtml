@model DoAnCoSo.Models.BienTheSanPham

@{
    ViewData["Title"] = "Chi tiết biến thể";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="form-card">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h3 class="mb-1 fw-bold">Chi tiết biến thể sản phẩm</h3>
            <p class="text-muted mb-0">Thông tin đầy đủ của biến thể</p>
        </div>
        <a asp-action="Index" class="btn-back">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="preview-box h-100">
                <span class="detail-label">Hình ảnh biến thể</span>
                <img src="@(string.IsNullOrWhiteSpace(Model.HinhAnh) ? "/images/no-image.png" : Model.HinhAnh)"
                     alt="Ảnh biến thể"
                     class="preview-img large" />
            </div>
        </div>

        <div class="col-md-8">
            <div class="detail-grid">
                <div class="detail-item">
                    <span class="detail-label">Mã biến thể</span>
                    <div class="detail-value">
                        <span class="code-badge">#@Model.MaBienThe</span>
                    </div>
                </div>

                <div class="detail-item">
                    <span class="detail-label">Sản phẩm</span>
                    <div class="detail-value fw-bold">@(Model.SanPham?.TenSanPham ?? "Chưa có sản phẩm")</div>
                </div>

                <div class="detail-item">
                    <span class="detail-label">Kích cỡ</span>
                    <div class="detail-value">@Model.KichCo</div>
                </div>

                <div class="detail-item">
                    <span class="detail-label">Màu sắc</span>
                    <div class="detail-value">@Model.MauSac</div>
                </div>

                <div class="detail-item">
                    <span class="detail-label">Giá</span>
                    <div class="detail-value fw-bold text-price">@Model.Gia.ToString("N0") VNĐ</div>
                </div>

                <div class="detail-item">
                    <span class="detail-label">Trạng thái</span>
                    <div class="detail-value">@Model.TrangThai</div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2 mt-4">
        <a asp-action="Edit" asp-route-id="@Model.MaBienThe" class="btn-save">
            <i class="bi bi-pencil-square"></i> Chỉnh sửa
        </a>
        <a asp-action="Index" class="btn-back">Quay lại danh sách</a>
    </div>
</div>