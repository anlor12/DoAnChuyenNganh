@model IEnumerable<DoAnCoSo.Models.BienTheSanPham>
@{
    ViewData["Title"] = "Biến thể sản phẩm";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    int totalVariants = Model?.Count() ?? 0;
    int activeVariants = Model?.Count(x => x.TrangThai == "Hoạt động" || x.TrangThai == "Còn bán" || string.IsNullOrWhiteSpace(x.TrangThai)) ?? 0;
    int parentProducts = Model?.Select(x => x.MaSanPham).Distinct().Count() ?? 0;
}

<div class="d-flex flex-column gap-3.5">

    <!-- TOP SUB-NAVIGATION PILL TABS + ACTION BAR -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2.5">
        <div class="v22-pill-tabs">
            <a asp-controller="SanPhams" asp-action="Index" class="v22-pill-tab">
                📦 Danh sách sản phẩm
            </a>
            <a asp-controller="BienTheSanPhams" asp-action="Index" class="v22-pill-tab active">
                🎨 Biến thể SKU (@totalVariants)
            </a>
            <a asp-controller="LoaiSanPhams" asp-action="Index" class="v22-pill-tab">
                🏷️ Quản lý danh mục
            </a>
            <a asp-controller="KhoHangs" asp-action="Index" class="v22-pill-tab">
                🏭 Quản lý kho hàng
            </a>
        </div>

        <a asp-action="Create" class="v22-btn-primary" style="border-radius: 9999px;">
            + Thêm Biến Thể Mới
        </a>
    </div>

    <!-- 3 KPI METRIC CARDS -->
    <div class="row g-3">
        <div class="col-md-4">
            <div class="v22-card p-3.5 d-flex align-items-center justify-content-between">
                <div>
                    <span class="font-mono text-muted text-uppercase" style="font-size: 10px;">Tổng biến thể</span>
                    <div class="font-display fw-bold" style="font-size: 24px;">@totalVariants <span style="font-size: 12px; font-weight: 500;" class="text-muted">mẫu mã SKU</span></div>
                </div>
                <span class="font-mono badge rounded-pill bg-success bg-opacity-10 text-success" style="font-size: 11px;">100% SKU</span>
            </div>
        </div>

        <div class="col-md-4">
            <div class="v22-card p-3.5 d-flex align-items-center justify-content-between">
                <div>
                    <span class="font-mono text-muted text-uppercase" style="font-size: 10px;">Đang hoạt động</span>
                    <div class="font-display fw-bold text-success" style="font-size: 24px;">@activeVariants <span style="font-size: 12px; font-weight: 500;" class="text-muted">khả dụng</span></div>
                </div>
                <span class="font-mono badge rounded-pill bg-success text-white" style="font-size: 11px;">Còn bán</span>
            </div>
        </div>

        <div class="col-md-4">
            <div class="v22-sage p-3.5 d-flex align-items-center justify-content-between">
                <div>
                    <span class="font-mono text-uppercase" style="font-size: 10px;">Sản phẩm gốc</span>
                    <div class="font-display fw-bold" style="font-size: 24px;">@parentProducts <span style="font-size: 12px; font-weight: 500;">sản phẩm</span></div>
                </div>
                <a asp-controller="SanPhams" asp-action="Index" class="fw-bold text-dark text-decoration-none" style="font-size: 12px;">Xem sản phẩm →</a>
            </div>
        </div>
    </div>

    <!-- TABLE VIEW -->
    <div class="v22-card overflow-hidden">
        <div class="p-3.5 border-bottom d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
                <h3 class="font-display fw-bold mb-0.5" style="font-size: 15px;">Danh Sách Biến Thể Sản Phẩm (Size / Màu Sắc)</h3>
                <p class="text-muted mb-0" style="font-size: 11.5px;">Quản lý kích cỡ (S, M, L, XL), màu sắc, giá bán và phân loại SKU chi tiết</p>
            </div>
            <div class="d-flex align-items-center gap-2" style="width: 300px; max-width: 100%;">
                <input type="text" id="searchInput" placeholder="Tìm biến thể (#1, áo polo, size M...)" class="v22-input py-1.5" style="font-size: 12px;" />
            </div>
        </div>

        <div class="table-responsive">
            <table class="v22-table" id="variantTable">
                <thead>
                    <tr>
                        <th style="width: 100px;">Mã BT</th>
                        <th style="width: 72px;">Ảnh</th>
                        <th>Sản phẩm gốc</th>
                        <th style="width: 110px;">Kích cỡ</th>
                        <th style="width: 120px;">Màu sắc</th>
                        <th style="width: 140px;">Giá bán</th>
                        <th style="width: 130px;">Trạng thái</th>
                        <th style="width: 150px;" class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            var rawImg = !string.IsNullOrWhiteSpace(item.HinhAnh) ? item.HinhAnh : item.SanPham?.HinhAnh;
                            var imgUrl = string.IsNullOrWhiteSpace(rawImg) || rawImg.Contains("ao-so-mi-trang.jpg.jpg")
                                ? "https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?auto=format&fit=crop&w=300&q=80"
                                : rawImg;

                            <tr>
                                <td class="font-mono fw-bold text-success">#@item.MaBienThe</td>
                                <td>
                                    <img src="@imgUrl"
                                         alt="SKU #@item.MaBienThe"
                                         class="v22-thumb"
                                         style="width: 44px; height: 44px; object-fit: cover; border-radius: 10px; flex-shrink: 0;"
                                         onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?auto=format&fit=crop&w=300&q=80';" />
                                </td>
                                <td>
                                    <div class="fw-bold text-truncate" style="font-size: 13px; max-width: 280px;">@(item.SanPham?.TenSanPham ?? "Chưa có sản phẩm")</div>
                                    <div class="font-mono text-muted" style="font-size: 10px;">ID SP: #@(item.MaSanPham)</div>
                                </td>
                                <td>
                                    <span class="badge rounded-pill bg-light text-dark border font-mono fw-bold px-2.5 py-1" style="font-size: 11px;">@item.KichCo</span>
                                </td>
                                <td>
                                    <span class="badge rounded-pill bg-light text-dark border px-2.5 py-1" style="font-size: 11px;">@item.MauSac</span>
                                </td>
                                <td class="font-mono fw-bold text-success">
                                    @item.Gia.ToString("N0") ₫
                                </td>
                                <td>
                                    <span class="badge rounded-pill @(item.TrangThai == "Ngừng bán" ? "bg-danger text-danger" : "bg-success text-success") bg-opacity-10 font-mono" style="font-size: 10.5px;">
                                        ● @(string.IsNullOrWhiteSpace(item.TrangThai) ? "Còn bán" : item.TrangThai)
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex align-items-center gap-1">
                                        <a asp-action="Edit" asp-route-id="@item.MaBienThe" class="btn btn-sm btn-light border px-2 py-1" title="Sửa"><i class="bi bi-pencil"></i></a>
                                        <a asp-action="Details" asp-route-id="@item.MaBienThe" class="btn btn-sm btn-light border px-2 py-1" title="Xem"><i class="bi bi-eye"></i></a>
                                        <a asp-action="Delete" asp-route-id="@item.MaBienThe" class="btn btn-sm btn-outline-danger px-2 py-1" title="Xóa"><i class="bi bi-trash"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">Chưa có biến thể nào</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        document.getElementById("searchInput")?.addEventListener("keyup", function () {
            const keyword = this.value.toLowerCase();
            const rows = document.querySelectorAll("#variantTable tbody tr");

            rows.forEach(row => {
                const text = row.innerText.toLowerCase();
                row.style.display = text.includes(keyword) ? "" : "none";
            });
        });
    </script>
}
