@model DoAnCoSo.Models.BienTheSanPham

@{
    ViewData["Title"] = "Cập nhật biến thể sản phẩm";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="form-card">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h3 class="mb-1 fw-bold">Cập nhật biến thể sản phẩm</h3>
            <p class="text-muted mb-0">Chỉnh sửa thông tin biến thể hiện có</p>
        </div>
        <a asp-action="Index" class="btn-back">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
    </div>

    <form asp-action="Edit" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input type="hidden" asp-for="MaBienThe" />

        <div class="row g-4">
            <div class="col-md-6">
                <label class="form-label">Mã biến thể</label>
                <input value="@Model.MaBienThe" class="form-control" disabled />
            </div>

            <div class="col-md-6">
                <label asp-for="MaSanPham" class="form-label">Sản phẩm</label>
                <select asp-for="MaSanPham" class="form-select" asp-items="ViewBag.MaSanPham">
                    <option value="">-- Chọn sản phẩm --</option>
                </select>
                <span asp-validation-for="MaSanPham" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="KichCo" class="form-label">Kích cỡ</label>
                <input asp-for="KichCo" class="form-control" />
                <span asp-validation-for="KichCo" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="MauSac" class="form-label">Màu sắc</label>
                <input asp-for="MauSac" class="form-control" />
                <span asp-validation-for="MauSac" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Gia" class="form-label">Giá biến thể</label>
                <input asp-for="Gia" class="form-control" />
                <span asp-validation-for="Gia" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="TrangThai" class="form-label">Trạng thái</label>
                <select asp-for="TrangThai" class="form-select">
                    <option value="">-- Chọn trạng thái --</option>
                    <option value="Hoạt động">Hoạt động</option>
                    <option value="Ngừng bán">Ngừng bán</option>
                    <option value="Sắp ra mắt">Sắp ra mắt</option>
                </select>
                <span asp-validation-for="TrangThai" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label class="form-label">Chọn ảnh mới</label>
                <input type="file" name="imageFile" class="form-control" accept="image/*" />
            </div>

            <div class="col-md-6">
                <div class="preview-box">
                    <span class="detail-label">Ảnh hiện tại</span>
                    <img src="@(string.IsNullOrWhiteSpace(Model.HinhAnh) ? "/images/no-image.png" : Model.HinhAnh)"
                         alt="Ảnh biến thể"
                         class="preview-img" />
                </div>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn-save">
                <i class="bi bi-check2-circle"></i> Cập nhật
            </button>
            <a asp-action="Index" class="btn-back">Hủy</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}