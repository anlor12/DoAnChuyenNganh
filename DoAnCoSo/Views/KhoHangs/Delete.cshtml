@model DoAnCoSo.Models.KhoHang

@{
    ViewData["Title"] = "Xóa kho hàng";
}

<h2>Xóa kho hàng</h2>

<h4>Bạn có chắc muốn xóa dòng kho này không?</h4>
<hr />

<dl class="row">
    <dt class="col-sm-3">Sản phẩm</dt>
    <dd class="col-sm-9">@Model.BienTheSanPham?.SanPham?.TenSanPham</dd>

    <dt class="col-sm-3">Size</dt>
    <dd class="col-sm-9">@Model.BienTheSanPham?.KichCo</dd>

    <dt class="col-sm-3">Màu</dt>
    <dd class="col-sm-9">@Model.BienTheSanPham?.MauSac</dd>

    <dt class="col-sm-3">Số lượng tồn</dt>
    <dd class="col-sm-9">@Model.SoLuongTon</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="MaKhoHang" />
    <button type="submit" class="btn btn-danger">Xóa</button>
    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>