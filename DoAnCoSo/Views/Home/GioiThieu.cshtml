    <div class="about-split-content">
        <p class="about-section-label">Câu chuyện thương hiệu</p>
        <h2 class="about-section-title">
            @(Model?.StoryTitle ?? "Sinh ra từ đam mê thời trang")
        </h2>
        <p class="about-body-text">
            @(Model?.StoryP1 ?? "Khởi đầu từ một cửa hàng nhỏ với ước mơ lớn vào năm 2020...")
        </p>
        <p class="about-body-text mt-3">
            @(Model?.StoryP2 ?? "Chúng tôi không ngừng tìm kiếm những chất liệu tốt nhất...")
