</section>

<!-- ===== SPLIT: STORY ===== -->
<div class="about-split">
    <div class="about-split-img">
        <img src="@(Model?.StoryImage ?? "/images/store-interior.jpg.jpg")"
             alt="Fashion Store Story"
             onerror="this.src=''; this.parentElement.style.background='#1a1a1a';" />
