@model DoAnCoSo.Models.CauHinhGioiThieuViewModel
@{
    Layout = "_LayoutCustomer";
    ViewData["Title"] = Model?.HeroTitle ?? "Giới thiệu";
}

@section Styles {
<style>
    /* ===== ABOUT HERO ===== */
    .about-hero {
        position: relative;
        height: 70vh;
        min-height: 480px;
        background: #0a0a0a;
        display: flex;
        align-items: flex-end;
        overflow: hidden;
    }

    .about-hero-bg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0.38;
        transform: scale(1.05);
        transition: transform 10s ease;
    }

    .about-hero.loaded .about-hero-bg { transform: scale(1.0); }

    .about-hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.2) 60%, transparent 100%);
    }

    .about-hero-content {
        position: relative;
        z-index: 2;
        max-width: 1300px;
        margin: 0 auto;
        width: 100%;
        padding: 0 40px 60px;
        animation: fadeUp 0.9s ease forwards;
    }

    @@keyframes fadeUp {
        from { opacity: 0; transform: translateY(30px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .about-eyebrow {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 5px;
        text-transform: uppercase;
        color: rgba(255,255,255,0.5);
        margin-bottom: 14px;
    }

    .about-hero-title {
        font-size: clamp(42px, 8vw, 100px);
        font-weight: 800;
        line-height: 0.92;
        letter-spacing: -2px;
        text-transform: uppercase;
        color: #fff;
        margin: 0;
    }

    .about-hero-title span {
        display: block;
        color: rgba(255,255,255,0.12);
        -webkit-text-stroke: 1.5px rgba(255,255,255,0.45);
    }

    /* ===== STAT BAR ===== */
    .stat-bar {
        background: #0a0a0a;
        padding: 0;
    }

    .stat-bar-inner {
        max-width: 1300px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        border-left: 1px solid rgba(255,255,255,0.08);
    }

    .stat-item {
        padding: 36px 40px;
        border-right: 1px solid rgba(255,255,255,0.08);
        text-align: center;
        position: relative;
        overflow: hidden;
        transition: background 0.3s;
    }

    .stat-item:hover { background: rgba(255,255,255,0.04); }

    .stat-number {
        font-size: clamp(36px, 5vw, 56px);
        font-weight: 800;
        color: #fff;
        letter-spacing: -1px;
        line-height: 1;
        margin-bottom: 8px;
        display: block;
    }

    .stat-label {
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 2.5px;
        text-transform: uppercase;
        color: rgba(255,255,255,0.4);
    }

    /* ===== MISSION SECTION ===== */
    .about-section {
        max-width: 1300px;
        margin: 0 auto;
        padding: 100px 40px;
    }

    .about-section-label {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 4px;
        text-transform: uppercase;
        color: #aaa;
        margin-bottom: 12px;
    }

    .about-section-title {
        font-size: clamp(28px, 4.5vw, 54px);
        font-weight: 800;
        letter-spacing: -0.5px;
        text-transform: uppercase;
        color: #0a0a0a;
        line-height: 1.05;
        margin-bottom: 28px;
    }

    .about-section-title em {
        font-style: normal;
        color: rgba(10,10,10,0.15);
        -webkit-text-stroke: 1.5px rgba(10,10,10,0.35);
    }

    .about-body-text {
        font-size: 16px;
        line-height: 1.8;
        color: #555;
        max-width: 600px;
    }

    .about-body-text strong { color: #0a0a0a; }

    /* ===== SPLIT IMAGE LAYOUT ===== */
    .about-split {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0;
        min-height: 560px;
    }

    .about-split-img {
        position: relative;
        overflow: hidden;
        background: #f0f0f0;
    }

    .about-split-img img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.7s ease;
        filter: grayscale(20%);
    }

    .about-split-img:hover img { transform: scale(1.04); filter: grayscale(0%); }

    .about-split-content {
        background: #0a0a0a;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 70px 60px;
    }

    .about-split-content .about-section-label { color: rgba(255,255,255,0.35); }
    .about-split-content .about-section-title { color: #fff; }
    .about-split-content .about-section-title em {
        color: rgba(255,255,255,0.1);
        -webkit-text-stroke: 1.5px rgba(255,255,255,0.3);
    }
    .about-split-content .about-body-text { color: rgba(255,255,255,0.55); }

    /* ===== VALUES GRID ===== */
    .values-section {
        background: #f7f7f5;
        padding: 100px 0;
    }

    .values-inner {
        max-width: 1300px;
        margin: 0 auto;
        padding: 0 40px;
    }

    .values-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2px;
        margin-top: 60px;
        background: #e0e0e0;
        border: 1px solid #e0e0e0;
    }

    .value-card {
        background: #f7f7f5;
        padding: 50px 40px;
        transition: background 0.3s, transform 0.3s;
        position: relative;
        overflow: hidden;
    }

    .value-card::before {
        content: '';
        position: absolute;
        bottom: 0; left: 0;
        width: 0;
        height: 3px;
        background: #0a0a0a;
        transition: width 0.4s ease;
    }

    .value-card:hover::before { width: 100%; }
    .value-card:hover { background: #fff; transform: translateY(-4px); }

    .value-icon {
        font-size: 32px;
        color: #0a0a0a;
        margin-bottom: 24px;
        display: block;
        transition: transform 0.3s;
    }

    .value-card:hover .value-icon { transform: scale(1.15); }

    .value-title {
        font-size: 14px;
        font-weight: 800;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #0a0a0a;
        margin-bottom: 14px;
    }

    .value-desc {
        font-size: 14px;
        color: #777;
        line-height: 1.7;
    }

    /* ===== TEAM ===== */
    .team-section {
        max-width: 1300px;
        margin: 0 auto;
        padding: 100px 40px;
    }

    .team-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 24px;
        margin-top: 60px;
    }

    .team-card {
        text-align: center;
    }

    .team-avatar {
        width: 100%;
        aspect-ratio: 1;
        object-fit: cover;
        background: #f0f0f0;
        margin-bottom: 20px;
        filter: grayscale(30%);
        transition: filter 0.4s, transform 0.4s;
    }

    .team-card:hover .team-avatar { filter: grayscale(0%); transform: scale(1.02); }

    .team-avatar-placeholder {
        width: 100%;
        aspect-ratio: 1;
        background: linear-gradient(135deg, #f0f0f0, #e0e0e0);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 20px;
        font-size: 48px;
        color: #ccc;
        transition: transform 0.4s;
    }

    .team-card:hover .team-avatar-placeholder { transform: scale(1.02); }

    .team-name {
        font-size: 13px;
        font-weight: 800;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #0a0a0a;
        margin-bottom: 4px;
    }

    .team-role {
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: #aaa;
    }

    /* ===== CTA BANNER ===== */
    .about-cta {
        background: #0a0a0a;
        padding: 100px 40px;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

    .about-cta::before {
        content: 'FASHION';
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        font-size: clamp(80px, 18vw, 220px);
        font-weight: 800;
        color: rgba(255,255,255,0.03);
        letter-spacing: -5px;
        text-transform: uppercase;
        white-space: nowrap;
        pointer-events: none;
    }

    .about-cta-content { position: relative; z-index: 1; }

    .about-cta-title {
        font-size: clamp(28px, 5vw, 60px);
        font-weight: 800;
        letter-spacing: -1px;
        text-transform: uppercase;
        color: #fff;
        margin-bottom: 16px;
    }

    .about-cta-sub {
        font-size: 14px;
        color: rgba(255,255,255,0.45);
        margin-bottom: 40px;
        letter-spacing: 1px;
    }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 1024px) {
        .team-grid { grid-template-columns: repeat(2, 1fr); }
        .stat-bar-inner { grid-template-columns: repeat(2, 1fr); }
    }

    @@media (max-width: 768px) {
        .about-hero-content { padding: 0 20px 50px; }
        .about-section { padding: 60px 20px; }
        .about-split { grid-template-columns: 1fr; }
        .about-split-content { padding: 50px 24px; }
        .values-inner { padding: 0 20px; }
        .values-grid { grid-template-columns: 1fr; }
        .team-section { padding: 60px 20px; }
        .team-grid { grid-template-columns: repeat(2, 1fr); }
        .about-cta { padding: 70px 20px; }
        .stat-bar-inner { grid-template-columns: repeat(2, 1fr); }
        .stat-item { padding: 28px 20px; }
    }
</style>
}

<!-- ===== ABOUT HERO ===== -->
<section class="about-hero" id="aboutHero">
