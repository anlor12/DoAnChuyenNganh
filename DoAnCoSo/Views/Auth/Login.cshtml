@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập";
    string? returnUrl = ViewBag.ReturnUrl as string;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập - Fashion Store</title>
    <link rel="stylesheet" href="~/css/login.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <style>
        .login-box {
            padding: 38px 34px !important;
            max-width: 410px !important;
            width: 90% !important;
        }
        .login-box h2 {
            margin-bottom: 25px !important;
        }
        .oauth-divider {
            display: flex;
            align-items: center;
            text-align: center;
            margin: 22px 0 16px;
            color: rgba(255, 255, 255, 0.6);
            font-size: 11px;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            font-weight: 600;
        }
        .oauth-divider::before, .oauth-divider::after {
            content: '';
            flex: 1;
            border-bottom: 1px solid rgba(255, 255, 255, 0.2);
        }
        .oauth-divider:not(:empty)::before {
            margin-right: .8em;
        }
        .oauth-divider:not(:empty)::after {
            margin-left: .8em;
        }
        .oauth-buttons {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-bottom: 15px;
        }
        .btn-oauth {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 10px 12px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.25s ease;
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }
        .btn-google {
            background: rgba(255, 255, 255, 0.95);
            color: #1f2937;
        }
        .btn-google:hover {
            background: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(0, 0, 0, 0.3);
            color: #111827;
        }
        .btn-facebook {
            background: #1877f2;
            color: #ffffff;
            border-color: #1877f2;
        }
        .btn-facebook:hover {
            background: #166fe5;
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(24, 119, 242, 0.4);
            color: #ffffff;
        }
        .onetap-badge {
            background: rgba(255, 193, 7, 0.2);
            border: 1px solid rgba(255, 193, 7, 0.4);
            color: #fef08a;
            border-radius: 8px;
            padding: 6px 10px;
            font-size: 11px;
            text-align: center;
            margin-top: 10px;
        }
        /* GOOGLE ONE-TAP POPUP STYLES */
        .google-onetap-box {
            position: fixed;
            top: 24px;
            right: 24px;
            width: 350px;
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
            padding: 16px 18px;
            z-index: 999;
            animation: slideInRight 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            color: #1f2937;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            border: 1px solid #e5e7eb;
        }
        @@keyframes slideInRight {
            from { opacity: 0; transform: translateX(30px); }
            to { opacity: 1; transform: translateX(0); }
        }
        .onetap-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 12px;
        }
        .onetap-brand-title {
            font-size: 13px;
            font-weight: 700;
            color: #111827;
            line-height: 1.2;
        }
        .onetap-brand-sub {
            font-size: 11px;
            color: #6b7280;
        }
        .onetap-close-btn {
            background: none;
            border: none;
            color: #9ca3af;
            font-size: 18px;
            cursor: pointer;
            padding: 2px 6px;
            border-radius: 50%;
            line-height: 1;
        }
        .onetap-close-btn:hover {
            color: #111827;
            background: #f3f4f6;
        }
        .onetap-user-row {
            display: flex;
            align-items: center;
            padding: 8px 10px;
            border-radius: 10px;
            border: 1px solid #e5e7eb;
            margin-bottom: 12px;
            cursor: pointer;
            transition: background 0.2s;
        }
        .onetap-user-row:hover {
            background: #f9fafb;
            border-color: #4285f4;
        }
        .onetap-user-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: #2563eb;
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 13px;
            margin-right: 10px;
            flex-shrink: 0;
        }
        .onetap-btn-cta {
            width: 100%;
            background: #1a73e8;
            color: #ffffff;
            border: none;
            border-radius: 8px;
            padding: 9px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.2s;
        }
        .onetap-btn-cta:hover {
            background: #1557b0;
        }
        .onetap-foot {
            text-align: center;
            margin-top: 10px;
        }
        .onetap-foot a {
            font-size: 11px;
            color: #4b5563;
            text-decoration: none;
        }
        .onetap-foot a:hover {
            text-decoration: underline;
            color: #1a73e8;
        }
    </style>
</head>
<body>

    <!-- ẢNH NỀN -->
    <img class="bg-image"
         id="bgImg"
         src="~/images/login-bg.jpg.jpg"
         alt="" />

    <!-- LỚP PHỦ TỐI -->
    <div class="bg-overlay"></div>

    <!-- GOOGLE ONE-TAP FLOATING CARD -->
    <div id="googleOneTapBox" class="google-onetap-box">
        <div class="onetap-head">
            <div style="display: flex; align-items: center; gap: 8px;">
                <svg width="22" height="22" viewBox="0 0 48 48">
                    <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                    <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                    <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.79l7.97-6.2z"/>
                    <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                </svg>
                <div>
                    <div class="onetap-brand-title">Đăng nhập với Google</div>
                    <div class="onetap-brand-sub">Fashion Store</div>
                </div>
            </div>
            <button type="button" class="onetap-close-btn" onclick="document.getElementById('googleOneTapBox').style.display='none'">&times;</button>
        </div>
        <form asp-controller="Auth" asp-action="FastOAuthLogin" method="post" id="oneTapForm">
            <input type="hidden" name="provider" value="Google" />
            <input type="hidden" name="email" value="nam.nguyen.fastpay@gmail.com" />
            <input type="hidden" name="name" value="Nguyễn Hoàng Nam" />
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <div class="onetap-user-row" onclick="document.getElementById('oneTapForm').submit()">
                <div class="onetap-user-avatar">NH</div>
                <div style="flex-grow: 1;">
                    <div style="font-weight: 700; font-size: 13px; color: #111827;">Nguyễn Hoàng Nam</div>
                    <div style="font-size: 11px; color: #6b7280;">nam.nguyen.fastpay@gmail.com</div>
                </div>
            </div>
            <button type="submit" class="onetap-btn-cta">
                <i class="fas fa-bolt me-1"></i> Tiếp tục dưới tên Nguyễn Hoàng Nam
            </button>
        </form>
        <div class="onetap-foot">
            <a asp-controller="Auth" asp-action="OAuthDemo" asp-route-provider="Google" asp-route-returnUrl="@returnUrl">
                <i class="fas fa-exchange-alt me-1"></i> Chọn tài khoản Google khác...
            </a>
        </div>
    </div>

    <!-- HỘP LOGIN GLASSMORPHISM -->
    <div class="login-box">
        <form id="loginForm" asp-action="Login" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <h2>ĐĂNG NHẬP</h2>

            @if (ViewBag.Error != null)
            {
                <div class="alert-error">
                    <i class="fas fa-exclamation-circle"></i> @ViewBag.Error
                </div>
            }

            @if (TempData["SuccessMessage"] != null)
            {
                <div style="background: rgba(34, 197, 94, 0.22); border: 1px solid rgba(34, 197, 94, 0.4); color: #86efac; border-radius: 8px; padding: 10px 14px; margin-bottom: 20px; font-size: 13px; text-align: center;">
                    <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
                </div>
            }

            <div class="input-group">
                <i class="fas fa-user"></i>
                <input type="text"
                       id="tenDangNhap"
                       name="tenDangNhap"
                       placeholder=" "
                       required />
                <label for="tenDangNhap">Tên đăng nhập</label>
            </div>

            <div class="input-group">
                <i class="fas fa-lock"></i>
                <input type="password"
                       id="matKhau"
                       name="matKhau"
                       placeholder=" "
                       required />
                <label for="matKhau">Mật khẩu</label>
            </div>

            <button type="submit" class="login-btn" id="submitBtn">ĐĂNG NHẬP</button>

            <!-- OAUTH 1-TAP SOCIAL BUTTONS -->
            <div class="oauth-divider">Hoặc tiếp tục với</div>
            
            <div class="oauth-buttons">
                <a asp-controller="Auth" asp-action="GoogleLogin" asp-route-returnUrl="@returnUrl" class="btn-oauth btn-google" title="Đăng nhập một chạm với Google">
                    <svg width="18" height="18" viewBox="0 0 48 48" style="margin-right: 8px;">
                        <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                        <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                        <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.79l7.97-6.2z"/>
                        <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                    </svg>
                    Google
                </a>
                <a asp-controller="Auth" asp-action="FacebookLogin" asp-route-returnUrl="@returnUrl" class="btn-oauth btn-facebook" title="Đăng nhập một chạm với Facebook">
                    <i class="fab fa-facebook-f" style="margin-right: 8px;"></i>
                    Facebook
                </a>
            </div>

            <div class="onetap-badge">
                <i class="fas fa-gift text-warning me-1"></i> Tự động tích 10.000đ điểm thưởng khi liên kết OAuth
            </div>

            <p class="signup-link">
                Chưa có tài khoản? <a asp-controller="Auth" asp-action="Register" asp-route-returnUrl="@returnUrl">Đăng ký ngay</a>
            </p>
        </form>
    </div>

    <script>
        var bgImg = document.getElementById('bgImg');
        bgImg.onerror = function () {
            this.src = 'https://images.pexels.com/photos/3408744/pexels-photo-3408744.jpeg?auto=compress&cs=tinysrgb&w=1920';
            this.onerror = function () {
                this.src = 'https://images.unsplash.com/photo-1490806843957-31f4c9a91c65?w=1920&q=80';
                this.onerror = function () {
                    this.style.display = 'none';
                    document.body.style.background =
                        'linear-gradient(160deg, #8B1A00 0%, #c0392b 15%, #87CEEB 45%, #4682B4 70%, #1a3a6c 100%)';
                };
            };
        };

        document.getElementById('loginForm').addEventListener('submit', function () {
            var btn = document.getElementById('submitBtn');
            btn.innerText = 'Đang xử lý...';
            btn.disabled = true;
            setTimeout(function () {
                btn.innerText = 'ĐĂNG NHẬP';
                btn.disabled = false;
            }, 5000);
        });
    </script>
</body>
</html>