@model DoAnCoSo.Models.DonHang

@{
    ViewData["Title"] = "Thêm đơn hàng";
}

<h2>Thêm đơn hàng</h2>

<div asp-validation-summary="All" class="text-danger mb-3"></div>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label asp-for="MaNguoiDung" class="form-label">Người dùng</label>
        <select asp-for="MaNguoiDung" asp-items="ViewBag.MaNguoiDung" class="form-control">
            <option value="">-- Chọn người dùng --</option>
        </select>
        <span asp-validation-for="MaNguoiDung" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="TongTien" class="form-label">Tổng tiền</label>
        <input asp-for="TongTien" class="form-control" />
        <span asp-validation-for="TongTien" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DiaChiGiaoHang" class="form-label">Địa chỉ giao hàng</label>
        <input asp-for="DiaChiGiaoHang" class="form-control" />
        <span asp-validation-for="DiaChiGiaoHang" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="SoDienThoaiNhan" class="form-label">Số điện thoại nhận</label>
        <input asp-for="SoDienThoaiNhan" class="form-control" />
        <span asp-validation-for="SoDienThoaiNhan" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="TrangThaiDonHang" class="form-label">Trạng thái đơn hàng</label>
        <select asp-for="TrangThaiDonHang" asp-items="ViewBag.TrangThaiDonHang" class="form-control"></select>
        <span asp-validation-for="TrangThaiDonHang" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="GhiChu" class="form-label">Ghi chú</label>
        <textarea asp-for="GhiChu" class="form-control"></textarea>
        <span asp-validation-for="GhiChu" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Lưu</button>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}