@model DoAnCoSo.Models.DonHang
@{
    Layout = null;
    decimal tongTienHang = Model.ChiTietDonHangs?.Sum(c => c.SoLuong * c.DonGia) ?? 0;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hóa đơn bán lẻ — #@Model.MaDonHang</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <style>
        * { box-sizing: border-box; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; }
        body { margin: 0; padding: 24px; background: #f8fafc; color: #1e293b; }
        .no-print-bar {
            max-width: 800px;
            margin: 0 auto 16px auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #fff;
            padding: 12px 24px;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        }
        .btn-print {
            background: #0f172a;
            color: #fff;
            padding: 10px 22px;
            border-radius: 6px;
            font-weight: 700;
            border: none;
            cursor: pointer;
            font-size: 13px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }
        .btn-close-win {
            background: #e2e8f0;
            color: #334155;
            padding: 10px 18px;
            border-radius: 6px;
            font-weight: 600;
            text-decoration: none;
            font-size: 13px;
        }
        .invoice-sheet {
            max-width: 800px;
            margin: 0 auto;
            background: #fff;
            padding: 36px 40px;
            border-radius: 8px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.06);
            border: 1px solid #e2e8f0;
        }
        .inv-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            border-bottom: 2px solid #0f172a;
            padding-bottom: 20px;
            margin-bottom: 24px;
        }
        .company-name {
            font-size: 22px;
            font-weight: 900;
            color: #0f172a;
            letter-spacing: 1px;
        }
        .company-info {
            font-size: 12px;
            color: #475569;
            line-height: 1.6;
            margin-top: 4px;
        }
        .inv-title-box {
            text-align: right;
        }
        .inv-main-title {
            font-size: 22px;
            font-weight: 900;
            color: #0f172a;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .inv-code {
            font-size: 13px;
            color: #0284c7;
            font-weight: 800;
            margin-top: 4px;
        }
        .inv-date {
            font-size: 12px;
            color: #64748b;
        }
        .cust-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 24px;
            font-size: 13px;
            background: #f8fafc;
            padding: 16px 20px;
            border-radius: 6px;
            border: 1px solid #f1f5f9;
        }
        .cust-line { margin-bottom: 6px; }
        .cust-lbl { color: #64748b; font-weight: 600; width: 110px; display: inline-block; }
        .cust-val { color: #0f172a; font-weight: 700; }
        .inv-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 12.5px;
            margin-bottom: 20px;
        }
        .inv-table th {
            background: #0f172a;
            color: #fff;
            padding: 10px 12px;
            text-align: left;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 11.5px;
            letter-spacing: 0.5px;
        }
        .inv-table td {
            padding: 12px;
            border-bottom: 1px solid #e2e8f0;
            vertical-align: middle;
        }
        .totals-section {
            margin-left: auto;
            width: 340px;
            font-size: 13px;
            margin-bottom: 24px;
        }
        .total-row {
            display: flex;
            justify-content: space-between;
            padding: 6px 0;
            border-bottom: 1px dashed #e2e8f0;
        }
        .total-grand {
            display: flex;
            justify-content: space-between;
            padding: 12px 0;
            border-top: 2px solid #0f172a;
            border-bottom: 2px solid #0f172a;
            font-size: 16px;
            font-weight: 900;
            color: #dc2626;
            margin-top: 6px;
        }
        .inv-footer {
            border-top: 1px solid #e2e8f0;
            padding-top: 20px;
            font-size: 12px;
            color: #64748b;
            line-height: 1.6;
        }
        .signature-grid {
            display: flex;
            justify-content: space-between;
            margin-top: 24px;
            text-align: center;
        }
        .sig-col { width: 40%; }
        .sig-blank { height: 65px; }

        @@media print {
            body { padding: 0; background: #fff; }
            .no-print-bar { display: none !important; }
            .invoice-sheet {
                box-shadow: none !important;
                border: none !important;
                padding: 0 !important;
                width: 100% !important;
                max-width: 100% !important;
            }
            @@page { size: A4 portrait; margin: 12mm; }
        }
    </style>
</head>
<body>
    <!-- Top Action Bar -->
    <div class="no-print-bar">
        <div>
            <strong>HÓA ĐƠN BÁN LẺ (RETAIL INVOICE)</strong>
            <div style="font-size: 12px; color: #64748b;">Đơn hàng: #@Model.MaDonHang · Hỗ trợ xuất / In PDF trực tiếp</div>
        </div>
        <div style="display:flex; gap: 10px;">
            <button type="button" class="btn-print" onclick="window.print()">
                <i class="fas fa-print"></i> In hóa đơn / Lưu PDF
            </button>
            <a href="javascript:window.close()" class="btn-close-win">Đóng</a>
        </div>
    </div>

    <!-- Main Printable Invoice -->
    <div class="invoice-sheet">
        <!-- Header -->
        <div class="inv-header">
            <div>
                <div class="company-name">FASHION STORE</div>
                <div class="company-info">
                    Hệ thống bán lẻ Thời trang Nam &amp; Nữ cao cấp<br />
                    Mã số thuế: <strong>0102345678</strong><br />
                    Địa chỉ: 98 Thái Hà, Quận Đống Đa, TP. Hà Nội<br />
                    Hotline: 1900 8079 · Email: support@fashionstore.vn · Web: fashionstore.vn
                </div>
            </div>
            <div class="inv-title-box">
                <div class="inv-main-title">HÓA ĐƠN BÁN LẺ</div>
                <div class="inv-code">Số: HD-@Model.NgayDat.ToString("yyyyMMdd")-@Model.MaDonHang</div>
                <div class="inv-date">Ngày lập: @Model.NgayDat.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
        </div>

        <!-- Customer & Order Info -->
        <div class="cust-grid">
            <div>
                <div class="cust-line"><span class="cust-lbl">Khách hàng:</span> <span class="cust-val">@(Model.NguoiDung?.HoTen ?? "Khách vãng lai")</span></div>
                <div class="cust-line"><span class="cust-lbl">Điện thoại:</span> <span class="cust-val">@Model.SoDienThoaiNhan</span></div>
                <div class="cust-line"><span class="cust-lbl">Địa chỉ:</span> <span class="cust-val">@Model.DiaChiGiaoHang</span></div>
            </div>
            <div>
                <div class="cust-line"><span class="cust-lbl">Thanh toán:</span> <span class="cust-val">@Model.PhuongThucThanhToan</span></div>
                <div class="cust-line">
                    <span class="cust-lbl">Trạng thái:</span> 
                    <span class="cust-val @(Model.TrangThaiThanhToan.Contains("Đã") ? "text-success" : "text-danger")">
                        @Model.TrangThaiThanhToan
                    </span>
                </div>
                <div class="cust-line">
                    <span class="cust-lbl">Vận chuyển:</span> 
                    <span class="cust-val">@(Model.DonViVanChuyen ?? "GHTK") (Mã: @(Model.MaVanDon ?? "Đang tạo"))</span>
                </div>
            </div>
        </div>

        <!-- Items Table -->
        <table class="inv-table">
            <thead>
                <tr>
                    <th style="width: 35px; text-align: center;">STT</th>
                    <th>Tên mặt hàng &amp; Quy cách</th>
                    <th style="width: 80px; text-align: center;">Phân loại</th>
                    <th style="width: 100px; text-align: right;">Đơn giá</th>
                    <th style="width: 60px; text-align: center;">SL</th>
                    <th style="width: 120px; text-align: right;">Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @{ int stt = 1; }
                @if (Model.ChiTietDonHangs != null)
                {
                    foreach (var item in Model.ChiTietDonHangs)
                    {
                        var sp = item.BienTheSanPham?.SanPham;
                        var bt = item.BienTheSanPham;
                        var rowTotal = item.SoLuong * item.DonGia;
                        <tr>
                            <td style="text-align: center; color: #64748b;">@stt</td>
                            <td>
                                <strong>@(sp?.TenSanPham ?? "Sản phẩm")</strong>
                                <div style="font-size: 11px; color: #64748b;">Mã SP: SP-@(sp?.MaSanPham ?? 0)</div>
                            </td>
                            <td style="text-align: center;">
                                @(bt?.KichCo) / @(bt?.MauSac)
                            </td>
                            <td style="text-align: right;">@item.DonGia.ToString("N0") ₫</td>
                            <td style="text-align: center; font-weight: 700;">@item.SoLuong</td>
                            <td style="text-align: right; font-weight: 700;">@rowTotal.ToString("N0") ₫</td>
                        </tr>
                        stt++;
                    }
                }
                @if (!string.IsNullOrEmpty(Model.QuaTangKem))
                {
                    <tr style="background: #fffbeb;">
                        <td style="text-align: center;">★</td>
                        <td colspan="4">
                            <strong>QUÀ TẶNG KÈM THEO ĐƠN: @Model.QuaTangKem</strong>
                        </td>
                        <td style="text-align: right; font-weight: 700; color: #16a34a;">0 ₫ (Miễn phí)</td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Totals Summary -->
        <div class="totals-section">
            <div class="total-row">
                <span style="color: #64748b;">Tổng tiền hàng:</span>
                <span style="font-weight: 700;">@tongTienHang.ToString("N0") ₫</span>
            </div>

            @if (Model.ChietKhauVip > 0 && Model.SoTienGiamVip > 0)
            {
                <div class="total-row" style="color: #dc2626;">
                    <span>Chiết khấu VIP (@Model.ChietKhauVip%):</span>
                    <span style="font-weight: 700;">-@Model.SoTienGiamVip.ToString("N0") ₫</span>
                </div>
            }

            @if (Model.SoTienGiam > 0)
            {
                <div class="total-row" style="color: #dc2626;">
                    <span>Khuyến mãi (@(Model.MaKhuyenMaiApDung ?? "Voucher")):</span>
                    <span style="font-weight: 700;">-@Model.SoTienGiam.ToString("N0") ₫</span>
                </div>
            }

            <div class="total-row">
                <span style="color: #64748b;">Phí vận chuyển (@(Model.DonViVanChuyen ?? "GHTK")):</span>
                <span style="font-weight: 700; color: @(Model.PhiGiaoHang == 0 ? "#16a34a" : "#0f172a");">
                    @(Model.PhiGiaoHang == 0 ? "0 ₫ (Freeship)" : Model.PhiGiaoHang.ToString("N0") + " ₫")
                </span>
            </div>

            <div class="total-grand">
                <span>TỔNG THANH TOÁN:</span>
                <span>@Model.TongTien.ToString("N0") ₫</span>
            </div>
        </div>

        <!-- Footer Notice & Signatures -->
        <div class="inv-footer">
            <div style="font-style: italic; margin-bottom: 8px;">
                * Giá trên đã bao gồm thuế Giá trị gia tăng (VAT). Quý khách vui lòng giữ hóa đơn này để đổi sản phẩm trong vòng 30 ngày.
            </div>
            <div style="font-weight: 600; color: #0f172a; text-align: center; margin: 10px 0;">
                Cảm ơn Quý khách đã mua sắm tại Fashion Store! Hân hạnh được phục vụ Quý khách lần sau.
            </div>

            <div class="signature-grid">
                <div class="sig-col">
                    <strong>Khách hàng / Người nhận</strong>
                    <div class="sig-blank"></div>
                    <div style="font-size: 11px; color: #64748b;">(Ký và ghi rõ họ tên)</div>
                </div>
                <div class="sig-col">
                    <strong>Người lập phiếu / Thu ngân</strong>
                    <div class="sig-blank"></div>
                    <div style="font-weight: 700; color: #0f172a;">Fashion Store Cashier System</div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
