@model IEnumerable<DoAnCoSo.Models.BoSuuTap>
@{
    ViewData["Title"] = "Quản lý Bộ sưu tập & Lookbook";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var list = Model ?? Enumerable.Empty<DoAnCoSo.Models.BoSuuTap>();
    int totalCollections = list.Count();
    int totalHotspots = list.Sum(s => s.DiemGhimBoSuuTaps?.Count ?? 0);
    int activeCollections = list.Count(x => x.TrangThai == "Hoạt động");
    var firstLookbook = list.FirstOrDefault();
    var previewImage = !string.IsNullOrEmpty(firstLookbook?.HinhAnh) ? firstLookbook.HinhAnh : "/images/store-interior.jpg.jpg";
}

<div class="d-flex flex-column gap-3.5">

    <!-- TOP SUB-NAVIGATION PILL TABS + ACTION -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2.5">
        <div class="v22-pill-tabs">
            <a asp-controller="BoSuuTaps" asp-action="Index" class="v22-pill-tab active">
                📸 Bộ sưu tập &amp; Lookbook (@totalCollections)
            </a>
            <a asp-controller="BaiViets" asp-action="Index" class="v22-pill-tab">
                📰 Bài viết &amp; Tin tức
            </a>
            <a asp-controller="CauHinhs" asp-action="GioiThieu" class="v22-pill-tab">
                🏛️ Trang Giới thiệu
            </a>
        </div>

        <a asp-action="Create" class="v22-btn-primary" style="border-radius: 9999px;">
            + Thêm Bộ Sưu Tập Mới
        </a>
    </div>

    <!-- NOTIFICATION ALERT -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-4 mb-0" role="alert" style="background: rgba(70, 155, 130, 0.12); color: #0C3226; border-left: 4px solid #469B82 !important;">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- 3 KPI BENTO METRIC CARDS -->
    <div class="row g-3">
        <div class="col-md-4">
            <div class="v22-card p-3.5 d-flex align-items-center justify-content-between">
                <div>
                    <span class="font-mono text-muted text-uppercase" style="font-size: 10px;">Tổng bộ sưu tập</span>
                    <div class="font-display fw-bold" style="font-size: 24px;">@totalCollections <span style="font-size: 12px; font-weight: 500;" class="text-muted">lookbook</span></div>
                    <span class="text-muted" style="font-size: 11px;">Chiến dịch hình ảnh thương hiệu</span>
                </div>
                <div class="rounded-3 p-2.5 bg-primary bg-opacity-10 text-primary">
                    <i class="bi bi-collection-play-fill fs-5"></i>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="v22-card p-3.5 d-flex align-items-center justify-content-between">
                <div>
                    <span class="font-mono text-muted text-uppercase" style="font-size: 10px;">Điểm ghim sản phẩm</span>
                    <div class="font-display fw-bold text-primary" style="font-size: 24px;">@totalHotspots <span style="font-size: 12px; font-weight: 500;" class="text-muted">vị trí</span></div>
                    <span class="text-primary" style="font-size: 11px;">● Tương tác Shop the Look</span>
                </div>
                <div class="rounded-3 p-2.5 bg-info bg-opacity-10 text-info">
                    <i class="bi bi-pin-map-fill fs-5"></i>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="v22-card p-3.5 d-flex align-items-center justify-content-between">
                <div>
                    <span class="font-mono text-muted text-uppercase" style="font-size: 10px;">Đang hiển thị trực tuyến</span>
                    <div class="font-display fw-bold text-success" style="font-size: 24px;">@activeCollections <span style="font-size: 12px; font-weight: 500;" class="text-muted">bộ</span></div>
                    <span class="text-success" style="font-size: 11px;">✓ Hoạt động trên cửa hàng</span>
                </div>
                <div class="rounded-3 p-2.5 bg-success bg-opacity-10 text-success">
                    <i class="bi bi-check2-circle fs-5"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- INTERACTIVE HOTSPOT STUDIO PREVIEW + COLLECTION LIST (MATCHING DEMO #cmsSub-lookbook) -->
    <div class="row g-3">
        <!-- Left 5 Cols: Interactive Hotspot Studio Preview -->
        <div class="col-lg-5">
            <div class="v22-card p-4 h-100 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <h3 class="font-display fw-bold mb-0" style="font-size: 15px;">Studio Ghim Điểm Sản Phẩm (Lookbook)</h3>
                        <span class="font-mono badge rounded-pill bg-success text-white" style="font-size: 10px;">Ghim trực tiếp</span>
                    </div>
                    <p class="text-muted mb-3" style="font-size: 11.5px;">Click bất kỳ vị trí nào trên ảnh mẫu để thử tạo điểm ghim tọa độ (X%, Y%) hoặc nhấn &quot;Cấu hình&quot; trên từng bộ sưu tập.</p>

                    <div id="lookbookInteractiveCanvas" onclick="addLookbookPin(event)" class="position-relative rounded-4 overflow-hidden border shadow-sm" style="height: 300px; cursor: crosshair; background: #0C3226;">
                        <img src="@previewImage" class="w-100 h-100" style="object-fit: cover; opacity: 0.9;" alt="Lookbook Studio" onerror="this.onerror=null;this.src='/images/store-interior.jpg.jpg';" />
                        <div class="position-absolute top-0 start-0 w-100 h-100" style="background: linear-gradient(to top, rgba(12,50,38,0.85), transparent 55%); pointer-events: none;"></div>

                        <!-- Pin 1 -->
                        <div class="position-absolute rounded-circle d-flex align-items-center justify-content-center text-white font-mono fw-bold shadow" style="left: 36%; top: 38%; width: 28px; height: 28px; background: #E07A5F; border: 2px solid #fff; font-size: 11px;">1</div>
                        <!-- Pin 2 -->
                        <div class="position-absolute rounded-circle d-flex align-items-center justify-content-center text-white font-mono fw-bold shadow" style="left: 58%; top: 62%; width: 28px; height: 28px; background: #469B82; border: 2px solid #fff; font-size: 11px;">2</div>

                        <div class="position-absolute bottom-0 start-0 p-3 text-white" style="pointer-events: none;">
                            <span class="font-mono text-uppercase" style="font-size: 9.5px; color: #7DD3B6;">LOOKBOOK PREVIEW</span>
                            <h4 class="font-display fw-bold mb-0" style="font-size: 16px;">@(firstLookbook?.TenBoSuuTap ?? "Executive Autumn Lookbook")</h4>
                        </div>
                    </div>
                </div>

                <div class="d-flex align-items-center justify-content-between pt-3 mt-3 border-top">
                    <span class="font-mono text-muted" style="font-size: 11px;">Tọa độ ghim tự động lưu theo % khung hình</span>
                    @if (firstLookbook != null)
                    {
                        <a asp-action="Edit" asp-route-id="@firstLookbook.MaBoSuuTap" class="v22-btn-outline py-1 px-2.5" style="font-size: 11.5px;">Mở Cấu Hình Ghim →</a>
                    }
                </div>
            </div>
        </div>

        <!-- Right 7 Cols: Lookbook Data Table -->
        <div class="col-lg-7">
            <div class="v22-card p-0 overflow-hidden h-100 d-flex flex-column">
                <div class="p-3.5 border-bottom d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <div>
                        <h3 class="font-display fw-bold mb-0" style="font-size: 15px;">Danh Sách Bộ Sưu Tập Hiện Có</h3>
                    </div>
                    <div style="width: 240px; max-width: 100%;">
                        <input type="text" id="searchInput" class="v22-input py-1.5" placeholder="Tìm bộ sưu tập..." style="font-size: 12px;" />
                    </div>
                </div>

                <div class="table-responsive flex-grow-1">
                    <table class="v22-table mb-0" id="boSuuTapTable">
                        <thead>
                            <tr>
                                <th style="width: 76px;">Ảnh bìa</th>
                                <th>Tên bộ sưu tập &amp; Mô tả</th>
                                <th style="width: 130px;">Điểm ghim</th>
                                <th style="width: 115px;">Trạng thái</th>
                                <th class="text-end" style="width: 135px;">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!list.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-5 text-muted">
                                        Chưa có bộ sưu tập thời trang nào trong hệ thống.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in list)
                                {
                                    var imgUrl = !string.IsNullOrEmpty(item.HinhAnh) ? item.HinhAnh : "/images/store-interior.jpg.jpg";
                                    <tr>
                                        <td>
                                            <img src="@imgUrl"
                                                 alt="@item.TenBoSuuTap"
                                                 class="v22-thumb-tall"
                                                 style="width: 56px; height: 72px; object-fit: cover; border-radius: 12px; flex-shrink: 0;"
                                                 onerror="this.onerror=null;this.src='/images/store-interior.jpg.jpg';" />
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center gap-1.5 mb-0.5">
                                                <span class="font-mono text-success fw-bold" style="font-size: 11px;">#@item.MaBoSuuTap</span>
                                                <span class="fw-bold font-display" style="font-size: 13.5px;">@item.TenBoSuuTap</span>
                                            </div>
                                            <div class="text-muted clamp-2" style="font-size: 11.5px; max-width: 280px;">
                                                @(string.IsNullOrEmpty(item.MoTa) ? "Bộ sưu tập thời trang định hình phong cách hiện đại." : item.MoTa)
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-primary bg-opacity-10 text-primary font-mono px-2.5 py-1" style="font-size: 10.5px;">
                                                📍 @(item.DiemGhimBoSuuTaps?.Count ?? 0) điểm
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge rounded-pill @(item.TrangThai == "Hoạt động" ? "bg-success text-success" : "bg-secondary text-secondary") bg-opacity-10 font-mono" style="font-size: 10.5px;">
                                                ● @item.TrangThai
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <div class="d-inline-flex align-items-center gap-1">
                                                <a asp-action="Edit" asp-route-id="@item.MaBoSuuTap" class="btn btn-sm btn-light border px-2 py-1" title="Cấu hình & Ghim điểm">
                                                    <i class="bi bi-pencil-square"></i>
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@item.MaBoSuuTap" class="btn btn-sm btn-outline-danger px-2 py-1" title="Xóa bộ sưu tập">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('searchInput')?.addEventListener('keyup', function () {
            let filter = this.value.toLowerCase();
            let rows = document.querySelectorAll('#boSuuTapTable tbody tr');

            rows.forEach(row => {
                let text = row.innerText.toLowerCase();
                row.style.display = text.includes(filter) ? '' : 'none';
            });
        });
    </script>
}
