@model DoAnCoSo.Models.BoSuuTap

@{
    ViewData["Title"] = "Xóa Bộ sưu tập Thời trang";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="architect-card" style="max-width: 600px; margin: 0 auto;">
    <div class="text-center mb-4">
        <div style="width: 64px; height: 64px; background: #fee2e2; color: #ef4444; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 32px; margin-bottom: 16px;">
            <i class="bi bi-trash3"></i>
        </div>
        <h4 class="fw-bold text-dark mb-1">Xác nhận xóa bộ sưu tập?</h4>
        <p class="text-muted small">Hành động này sẽ xóa vĩnh viễn bộ sưu tập và toàn bộ các điểm ghim liên kết.</p>
    </div>

    <div class="p-3 border rounded-3 bg-light mb-4">
        <div class="d-flex align-items-center gap-3">
            @if (!string.IsNullOrEmpty(Model.HinhAnh))
            {
                <img src="@Model.HinhAnh" alt="@Model.TenBoSuuTap" style="width: 70px; height: 90px; object-fit: cover; border-radius: 8px;" />
            }
            <div>
                <h6 class="fw-bold mb-1 text-dark">@Model.TenBoSuuTap</h6>
                <div class="text-muted small mb-1">Mã bộ sưu tập: #@Model.MaBoSuuTap</div>
                <div class="text-muted small">@(string.IsNullOrEmpty(Model.MoTa) ? "Không có mô tả" : Model.MoTa)</div>
            </div>
        </div>
    </div>

    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="MaBoSuuTap" />
        <div class="d-flex justify-content-center gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                <i class="bi bi-x-lg me-1"></i> Hủy bỏ
            </a>
            <button type="submit" class="btn btn-danger px-4">
                <i class="bi bi-trash3-fill me-1"></i> Xác nhận xóa
            </button>
        </div>
    </form>
</div>
