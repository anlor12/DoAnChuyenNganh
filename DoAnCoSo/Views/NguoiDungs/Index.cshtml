@model IEnumerable<DoAnCoSo.Models.NguoiDung>
@inject DoAnCoSo.Data.ApplicationDbContext _db
@{
    ViewData["Title"] = "Quản lý khách hàng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var userList = Model ?? Enumerable.Empty<DoAnCoSo.Models.NguoiDung>();
    int totalCustomers = userList.Count();
    int customersWithOrders = _db.DonHangs.Select(o => o.MaNguoiDung).Distinct().Count();
    int active30d = _db.DonHangs.Where(o => o.NgayDat >= DateTime.Today.AddDays(-30)).Select(o => o.MaNguoiDung).Distinct().Count();
    
    decimal totalRevenue = _db.DonHangs
        .Where(o => o.TrangThaiDonHang == "Hoàn thành" || o.TrangThaiThanhToan == "Đã thanh toán")
        .Sum(o => o.TongTien);
    decimal avgSpent = customersWithOrders > 0 ? totalRevenue / customersWithOrders : 0;
}

<div class="d-flex flex-column gap-3.5">

    <!-- TOP SUB-NAVIGATION PILL TABS + ACTIONS -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2.5">
        <div class="v22-pill-tabs">
            <a asp-controller="KhuyenMais" asp-action="Index" class="v22-pill-tab">
                🎟️ Khuyến mãi &amp; Quà tặng
            </a>
            <a asp-controller="Marketing" asp-action="AbandonedCarts" class="v22-pill-tab">
                🛒 Giải cứu giỏ hàng
            </a>
            <a asp-controller="Vip" asp-action="Index" class="v22-pill-tab">
                👑 Chính sách VIP 11 Bậc
            </a>
            <a asp-controller="Marketing" asp-action="LoyaltyProgram" class="v22-pill-tab">
                🪙 Điểm thưởng &amp; Giới thiệu
            </a>
            <a asp-controller="NguoiDungs" asp-action="Index" class="v22-pill-tab active">
                👥 Hồ sơ khách hàng (@totalCustomers)
            </a>
            <a asp-controller="DanhGias" asp-action="Index" class="v22-pill-tab">
                ⭐ Đánh giá &amp; Gemini AI
            </a>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-2">
            <a asp-action="ExportExcel" class="v22-btn-outline" style="border-radius: 9999px;">
                📥 Xuất Excel KH
            </a>
            <a asp-action="Create" class="v22-btn-primary" style="border-radius: 9999px;">
                + Thêm Khách Hàng
            </a>
        </div>
    </div>

    <!-- 4 KPI BENTO METRIC CARDS -->
    <div class="row g-3">
        <div class="col-sm-6 col-xl-3">
            <div class="v22-card p-3.5 d-flex align-items-center justify-content-between">
                <div>
                    <span class="font-mono text-muted text-uppercase" style="font-size: 10px;">Tổng khách hàng</span>
                    <div class="font-display fw-bold" style="font-size: 24px;">@totalCustomers <span style="font-size: 12px; font-weight: 500;" class="text-muted">tài khoản</span></div>
                    <span class="text-muted" style="font-size: 11px;">Đã đăng ký trong hệ thống</span>
                </div>
                <div class="rounded-3 p-2.5 bg-primary bg-opacity-10 text-primary">
                    <i class="bi bi-people-fill fs-5"></i>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="v22-card p-3.5 d-flex align-items-center justify-content-between">
                <div>
                    <span class="font-mono text-muted text-uppercase" style="font-size: 10px;">Khách đã mua hàng</span>
                    <div class="font-display fw-bold text-success" style="font-size: 24px;">@customersWithOrders <span style="font-size: 12px; font-weight: 500;" class="text-muted">người</span></div>
                    <span class="text-success" style="font-size: 11px;">● Tỷ lệ chuyển đổi cao</span>
                </div>
                <div class="rounded-3 p-2.5 bg-success bg-opacity-10 text-success">
                    <i class="bi bi-cart-check fs-5"></i>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="v22-card p-3.5 d-flex align-items-center justify-content-between">
                <div>
                    <span class="font-mono text-muted text-uppercase" style="font-size: 10px;">Hoạt động 30 ngày</span>
                    <div class="font-display fw-bold text-primary" style="font-size: 24px;">@active30d <span style="font-size: 12px; font-weight: 500;" class="text-muted">khách</span></div>
                    <span class="text-muted" style="font-size: 11px;">Có phát sinh đơn gần đây</span>
                </div>
                <div class="rounded-3 p-2.5 bg-info bg-opacity-10 text-info">
                    <i class="bi bi-lightning-fill fs-5"></i>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="v22-sage p-3.5 d-flex align-items-center justify-content-between">
                <div>
                    <span class="font-mono text-uppercase" style="font-size: 10px;">Chi tiêu trung bình</span>
                    <div class="font-display fw-bold" style="font-size: 21px;">@avgSpent.ToString("N0") ₫</div>
                    <span class="text-muted" style="font-size: 11px;">Trung bình trên từng khách</span>
                </div>
                <div class="rounded-3 p-2.5 bg-dark text-white">
                    <i class="bi bi-wallet2 fs-5"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- CUSTOMER LIST TABLE -->
    <div class="v22-card p-0 overflow-hidden">
        <div class="p-3.5 border-bottom d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
                <h3 class="font-display fw-bold mb-0.5" style="font-size: 15px;">Danh Sách Hồ Sơ Khách Hàng</h3>
                <p class="text-muted mb-0" style="font-size: 11.5px;">Quản lý thông tin tài khoản, hạng thành viên, tổng chi tiêu và điểm tích lũy</p>
            </div>
            <div style="width: 300px; max-width: 100%;">
                <input type="text" id="searchInput" class="v22-input py-1.5" placeholder="Tìm tên khách, email, số điện thoại..." style="font-size: 12px;" />
            </div>
        </div>

        <div class="table-responsive">
            <table class="v22-table mb-0" id="customerTable">
                <thead>
                    <tr>
                        <th>Khách hàng</th>
                        <th>Vai trò hệ thống</th>
                        <th>Ngày đăng ký</th>
                        <th class="text-center" style="width: 120px;">Số đơn hàng</th>
                        <th class="text-end" style="width: 170px;">Tổng chi tiêu</th>
                        <th class="text-end" style="width: 110px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!userList.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                Chưa có hồ sơ khách hàng nào trong hệ thống.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in userList)
                        {
                            int ordersCount = _db.DonHangs.Count(o => o.MaNguoiDung == item.MaNguoiDung);
                            decimal totalSpent = _db.DonHangs
                                .Where(o => o.MaNguoiDung == item.MaNguoiDung && (o.TrangThaiDonHang == "Hoàn thành" || o.TrangThaiThanhToan == "Đã thanh toán"))
                                .Sum(o => (decimal?)o.TongTien) ?? 0;

                            var avatarLetter = !string.IsNullOrEmpty(item.HoTen) ? item.HoTen.Substring(0, 1).ToUpper() : "K";
                            var roleName = item.TaiKhoan?.VaiTro ?? "Khách hàng";
                            if (roleName == "Quản trị viên") roleName = "Quản trị hệ thống";

                            var regDateString = item.TaiKhoan != null ? item.TaiKhoan.NgayTao.ToString("dd/MM/yyyy") : "—";
                            var regDateRelative = "Mới tham gia";
                            if (item.TaiKhoan != null)
                            {
                                var diffDays = (DateTime.Now - item.TaiKhoan.NgayTao).Days;
                                regDateRelative = diffDays == 0 ? "Hôm nay" : $"{diffDays} ngày trước";
                            }

                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2.5">
                                        <div class="rounded-circle text-white fw-bold d-flex align-items-center justify-content-center flex-shrink-0" style="width: 36px; height: 36px; background: #0C3226; font-size: 13px;">
                                            @avatarLetter
                                        </div>
                                        <div>
                                            <div class="fw-bold font-display" style="font-size: 13.5px;">@item.HoTen</div>
                                            <span class="font-mono text-muted" style="font-size: 10.5px;">@(item.TaiKhoan?.Email ?? "khach@fashionstore.vn") • ID: #@item.MaNguoiDung</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge @(roleName.Contains("Quản trị") ? "bg-dark text-white" : "bg-light text-dark border") font-mono px-2.5 py-1" style="font-size: 11px;">
                                        @roleName
                                    </span>
                                </td>
                                <td>
                                    <div class="font-mono" style="font-size: 12px;">@regDateString</div>
                                    <span class="font-mono text-muted" style="font-size: 10.5px;">@regDateRelative</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border font-mono px-2.5 py-1">@ordersCount đơn</span>
                                </td>
                                <td class="text-end font-mono fw-bold text-success" style="font-size: 13.5px;">
                                    @totalSpent.ToString("N0") ₫
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex align-items-center gap-1">
                                        <a asp-action="Edit" asp-route-id="@item.MaNguoiDung" class="btn btn-sm btn-light border px-2 py-1" title="Sửa thông tin">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.MaNguoiDung" class="btn btn-sm btn-outline-danger px-2 py-1" title="Xóa khách hàng">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById("searchInput")?.addEventListener("keyup", function () {
            const keyword = this.value.toLowerCase();
            const rows = document.querySelectorAll("#customerTable tbody tr");

            rows.forEach(row => {
                const text = row.innerText.toLowerCase();
                row.style.display = text.includes(keyword) ? "" : "none";
            });
        });
    </script>
}
