@model DoAnCoSo.Models.LoaiSanPham

@{
    ViewData["Title"] = "Cập nhật loại sản phẩm";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="form-card">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h3 class="mb-1 fw-bold">Cập nhật loại sản phẩm</h3>
            <p class="text-muted mb-0">Chỉnh sửa thông tin loại sản phẩm hiện có</p>
        </div>
        <a asp-action="Index" class="btn-back">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
    </div>

    <form asp-action="Edit" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input type="hidden" asp-for="MaLoaiSanPham" />
        <input type="hidden" asp-for="HinhAnh" />

        <div class="row g-4">
            <div class="col-md-12">
                <label class="form-label">Mã loại sản phẩm</label>
                <input value="@Model.MaLoaiSanPham" class="form-control" disabled />
            </div>

            <div class="col-md-12">
                <label asp-for="TenLoaiSanPham" class="form-label">Tên loại sản phẩm</label>
                <input asp-for="TenLoaiSanPham" class="form-control" />
                <span asp-validation-for="TenLoaiSanPham" class="text-danger"></span>
            </div>

            <div class="col-md-12">
                <label asp-for="MaLoaiCha" class="form-label">Danh mục cha (Trực thuộc)</label>
                <select asp-for="MaLoaiCha" asp-items="ViewBag.MaLoaiCha" class="form-select">
                    <option value="">-- Là danh mục gốc (Danh mục cha) --</option>
                </select>
                <span asp-validation-for="MaLoaiCha" class="text-danger"></span>
                <small class="text-muted d-block mt-1">Chọn danh mục cha nếu đây là danh mục con (ví dụ: Áo T-Shirt thuộc Áo, Giày Sneaker thuộc Giày).</small>
            </div>

            <div class="col-md-12">
                <label class="form-label">Hình ảnh danh mục</label>
                <input type="file" name="imageFile" class="form-control" accept="image/*" id="imageInput" />
                <div class="mt-2">
                    @if (!string.IsNullOrEmpty(Model.HinhAnh))
                    {
                        <p class="text-muted mb-1" style="font-size: 11px;">Ảnh hiện tại:</p>
                        <img id="imagePreview" src="@Model.HinhAnh" alt="Ảnh danh mục" style="max-width: 150px; display: block; border-radius: 4px; border: 1px solid #ddd;" />
                    }
                    else
                    {
                        <img id="imagePreview" src="#" alt="Xem trước ảnh" style="max-width: 150px; display: none; border-radius: 4px; border: 1px solid #ddd;" />
                    }
                </div>
            </div>

            <div class="col-md-12">
                <label asp-for="MoTa" class="form-label">Mô tả</label>
                <textarea asp-for="MoTa" class="form-control" rows="5"></textarea>
                <span asp-validation-for="MoTa" class="text-danger"></span>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn-save">
                <i class="bi bi-check2-circle"></i> Cập nhật
            </button>
            <a asp-action="Index" class="btn-back">Hủy</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.getElementById('imageInput').addEventListener('change', function (e) {
            const preview = document.getElementById('imagePreview');
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (event) {
                    preview.src = event.target.result;
                    preview.style.display = 'block';
                }
                reader.readAsDataURL(file);
            }
        });
    </script>
}