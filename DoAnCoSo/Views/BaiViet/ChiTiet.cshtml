@model DoAnCoSo.Models.BaiViet

@{
    ViewData["Title"] = Model.TieuDe;
    Layout = "~/Views/Shared/_LayoutCustomer.cshtml";
    var relatedPosts = ViewBag.RelatedPosts as List<DoAnCoSo.Models.BaiViet>;
}

@section Styles {
<style>
    .article-header {
        background: #fafafa;
        border-bottom: 1px solid #eee;
        padding: 60px 0 40px;
    }
    .article-title {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: clamp(28px, 4vw, 44px);
        font-weight: 800;
        line-height: 1.2;
        color: #111827;
        margin-bottom: 20px;
    }
    .article-content {
        font-size: 17px;
        line-height: 1.85;
        color: #374151;
    }
    .article-content p {
        margin-bottom: 24px;
    }
    .article-content h2, .article-content h3 {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-weight: 800;
        color: #111827;
        margin-top: 36px;
        margin-bottom: 18px;
    }
    .article-content img {
        max-width: 100%;
        height: auto;
        border-radius: 12px;
        margin: 24px 0;
        box-shadow: 0 4px 20px rgba(0,0,0,0.06);
    }
    .article-content ul, .article-content ol {
        margin-bottom: 24px;
        padding-left: 24px;
    }
    .article-content li {
        margin-bottom: 10px;
    }
    .article-lead {
        font-size: 19px;
        font-weight: 500;
        line-height: 1.7;
        color: #4b5563;
        border-left: 4px solid #111;
        padding-left: 20px;
        margin-bottom: 32px;
        font-style: italic;
    }
    .author-card {
        background: #f9fafb;
        border-radius: 16px;
        padding: 30px;
        border: 1px solid #f3f4f6;
    }
</style>
}

<!-- HEADER SECTION -->
<div class="article-header">
    <div class="container" style="max-width: 860px;">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="/BaiViet" class="text-decoration-none text-muted">Bài viết</a></li>
                <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">@(Model.ChuyenMuc ?? "Tin tức")</li>
            </ol>
        </nav>

        <span class="badge bg-dark text-uppercase px-3 py-2 rounded-pill mb-3" style="letter-spacing: 1px; font-size: 11px;">
            @(Model.ChuyenMuc ?? "Xu hướng thời trang")
        </span>

        <h1 class="article-title">@Model.TieuDe</h1>

        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 pt-3 border-top text-muted small">
            <div class="d-flex align-items-center gap-3">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 12px;">
                        @(string.IsNullOrEmpty(Model.TacGia) ? "A" : Model.TacGia.Substring(0, 1).ToUpper())
                    </div>
                    <span class="fw-bold text-dark">@(Model.TacGia ?? "Fashion Store")</span>
                </div>
                <span>•</span>
                <div><i class="far fa-calendar-alt me-1"></i> @Model.NgayTao.ToString("dd/MM/yyyy")</div>
                <span>•</span>
                <div><i class="far fa-eye me-1"></i> @Model.LuotXem.ToString("N0") lượt xem</div>
            </div>

            <div>
                <a href="#share" class="btn btn-sm btn-outline-secondary rounded-pill px-3" onclick="navigator.clipboard.writeText(window.location.href); alert('Đã sao chép liên kết bài viết!'); return false;">
                    <i class="fas fa-link me-1"></i> Chia sẻ
                </a>
            </div>
        </div>
    </div>
</div>

<!-- ARTICLE BODY -->
<div class="container py-5" style="max-width: 860px;">
    <!-- FEATURED IMAGE -->
    @if (!string.IsNullOrEmpty(Model.HinhAnh))
    {
        <div class="mb-5">
            <img src="@Model.HinhAnh" alt="@Model.TieuDe" class="w-100 rounded-4 shadow-sm" style="max-height: 480px; object-fit: cover;" onerror="this.style.display='none'" />
        </div>
    }

    <!-- EXCERPT -->
    @if (!string.IsNullOrEmpty(Model.TomTat))
    {
        <div class="article-lead">
            @Model.TomTat
        </div>
    }

    <!-- CONTENT -->
    <div class="article-content">
        @Html.Raw(Model.NoiDung)
    </div>

    <!-- AUTHOR BOX -->
    <div class="author-card my-5 d-flex align-items-center gap-4">
        <div class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center fw-bold fs-3 flex-shrink-0" style="width: 64px; height: 64px;">
            @(string.IsNullOrEmpty(Model.TacGia) ? "F" : Model.TacGia.Substring(0, 1).ToUpper())
        </div>
        <div>
            <h5 class="fw-bold mb-1">@(Model.TacGia ?? "Ban Biên Tập FASHION STORE")</h5>
            <p class="text-muted small mb-0">Chuyên viên tư vấn phong cách &amp; thời trang nam cao cấp. Đồng hành cùng hàng ngàn quý ông trên hành trình khẳng định bản sắc.</p>
        </div>
    </div>

    <!-- RELATED POSTS -->
    @if (relatedPosts != null && relatedPosts.Any())
    {
        <div class="mt-5 pt-4 border-top">
            <h3 class="fw-bold mb-4" style="font-size: 22px;">
                <i class="fas fa-book-open text-primary me-2"></i>Bài viết liên quan
            </h3>
            <div class="row g-4">
                @foreach (var rel in relatedPosts)
                {
                    <div class="col-md-4">
                        <div class="card h-100 border-0 shadow-sm rounded-3 overflow-hidden">
                            <img src="@(string.IsNullOrEmpty(rel.HinhAnh) ? "/images/news_office_gentleman.png" : rel.HinhAnh)" 
                                 class="card-img-top object-fit-cover" 
                                 style="height: 140px;" 
                                 alt="@rel.TieuDe" 
                                 onerror="this.src='/images/news_office_gentleman.png';" />
                            <div class="card-body p-3">
                                <span class="badge bg-light text-muted border small mb-2">@(rel.ChuyenMuc ?? "Tin tức")</span>
                                <h6 class="fw-bold mb-2">
                                    <a href="/BaiViet/ChiTiet/@rel.MaBaiViet" class="text-dark text-decoration-none">
                                        @rel.TieuDe
                                    </a>
                                </h6>
                                <small class="text-muted"><i class="far fa-calendar-alt me-1"></i>@rel.NgayTao.ToString("dd/MM/yyyy")</small>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- BACK BUTTON -->
    <div class="text-center mt-5">
        <a href="/BaiViet" class="btn btn-outline-dark rounded-pill px-4 py-2 fw-bold">
            <i class="fas fa-arrow-left me-2"></i> Quay lại trang tin tức
        </a>
    </div>
</div>
