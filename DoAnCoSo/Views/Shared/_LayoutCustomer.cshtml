            white-space: nowrap !important;

            transition: all 0.2s ease !important;

            align-self: center !important;

            flex-shrink: 0 !important;

            text-align: center !important;

        }

        .chat-product-item:hover .chat-product-action {

            background: #111 !important;

            color: #fff !important;

        }



        /* ========================================================

           DROPDOWN MENU ÁO, QUẦN & PHỤ KIỆN (DANH MỤC + BANNER FASHION)

           ======================================================== */

        .nav-dropdown-ao-panel,

        .nav-dropdown-quan-panel,

        .nav-dropdown-phukien-panel {

            position: absolute;

            top: 100%;

            left: 0;

            width: 580px;

            background-color: #0b0b0b;

            border: 1px solid rgba(255, 255, 255, 0.15);

            border-radius: 8px;

            padding: 16px 18px;

            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.7);

            display: flex;

            align-items: center;

            gap: 18px;

            opacity: 0;

            visibility: hidden;

            transform: translateY(10px);

            transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s;

            z-index: 1050;

            pointer-events: none;

        }



        .nav-dropdown-phukien-panel {

            width: 630px;

        }



        /* Hover bridge: đảm bảo di chuột từ nút xuống menu không bị mất */

        .nav-dropdown-ao-panel::before,

        .nav-dropdown-quan-panel::before,

        .nav-dropdown-phukien-panel::before {

            content: '';

            position: absolute;

            top: -15px;

            left: 0;

            right: 0;

            height: 15px;

            background: transparent;

        }



        .nav-item-dropdown:hover .nav-dropdown-ao-panel,

        .nav-item-dropdown:hover .nav-dropdown-quan-panel,

        .nav-item-dropdown:hover .nav-dropdown-phukien-panel {

            opacity: 1;

            visibility: visible;

            transform: translateY(0);

            pointer-events: auto;

        }



        .nav-item-dropdown:hover .nav-dropdown-toggle i {

            transform: rotate(180deg);

        }



        /* Cột danh mục */

        .ao-dropdown-links,

        .quan-dropdown-links {

            flex: 0 0 210px;

            display: flex;

            flex-direction: column;

            gap: 2px;

        }



        .phukien-dropdown-links {

            flex: 0 0 265px;

            display: flex;

            flex-direction: column;

            gap: 4px;

        }



        .ao-link-item,

        .quan-link-item,

        .phukien-link-item {

            display: flex !important;

            align-items: center;

            padding: 6px 10px !important;

            color: rgba(255, 255, 255, 0.85) !important;

            font-size: 12.5px !important;

            font-weight: 500 !important;

            text-decoration: none !important;

            letter-spacing: 0.3px !important;

            border-radius: 4px;

            transition: all 0.2s ease !important;

            text-align: left !important;

            white-space: nowrap;

        }



        .ao-link-item:hover,

        .quan-link-item:hover,

        .phukien-link-item:hover {

            color: #ffffff !important;

            background-color: rgba(255, 255, 255, 0.12) !important;

            transform: translateX(3px);

        }



        .ao-link-item.ao-link-all,

        .quan-link-item.quan-link-all,

        .phukien-link-item.phukien-link-all {

            color: #ffffff !important;

            font-weight: 700 !important;

            border-bottom: 1px solid rgba(255, 255, 255, 0.15);

            padding-bottom: 7px !important;

            margin-bottom: 4px;

            border-radius: 0;

        }



        /* Phụ kiện sub-columns */

        .phukien-subgroups {

            display: grid;

            grid-template-columns: 1fr 1fr;

            gap: 10px;

        }



        .phukien-subgroup-head {

            display: block;

            font-size: 11px;

            font-weight: 700;

            letter-spacing: 0.5px;

            color: #f59e0b;

            padding: 2px 6px 4px 6px;

            margin-bottom: 3px;

            border-bottom: 1px solid rgba(255, 255, 255, 0.15);

            text-decoration: none;

            text-transform: uppercase;

        }



        .phukien-subgroup-head.head-other {

            color: #38bdf8;

        }



        .phukien-subgroup-head:hover {

            color: #ffffff;

        }



        .phukien-subgroups .phukien-link-item {

            padding: 4px 6px !important;

            font-size: 11.5px !important;

        }



        /* Banner bên phải */

        .ao-dropdown-banner,

        .quan-dropdown-banner,

        .phukien-dropdown-banner {

            flex: 1;

            min-width: 0;

        }



        .ao-banner-link,

        .quan-banner-link,

        .phukien-banner-link {

            display: block;

            border-radius: 6px;

            overflow: hidden;

            background: #ffffff;

            border: 1px solid rgba(255, 255, 255, 0.1);

            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);

            transition: transform 0.25s ease, box-shadow 0.25s ease;

            text-decoration: none;

            height: 150px;

        }



        .ao-banner-link:hover,

        .quan-banner-link:hover,

        .phukien-banner-link:hover {

            transform: scale(1.02);

            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.55);

        }



        .ao-banner-link img,

        .quan-banner-link img,

        .phukien-banner-link img {

            width: 100%;

            height: 100%;

            object-fit: cover;

            display: block;

        }

    
        /* ========================================================
           MEGA DROPDOWN KHÁM PHÁ (CHUẨN STYLE TẤT CẢ PHỤ KIỆN)
           ======================================================== */
