            </div>



            <!-- TABS / ACTIONS -->

            <div class="p-3">

                <!-- AI QUICK LAUNCH BANNER -->

                <div class="p-2 mb-2 rounded-3 d-flex align-items-center justify-content-between" style="background: linear-gradient(135deg, #1e1b4b, #312e81); color: #fff; cursor: pointer; transition: transform 0.2s;" onmouseover="this.style.transform='scale(1.02)'" onmouseout="this.style.transform='scale(1)'" onclick="toggleChatWindow()">

