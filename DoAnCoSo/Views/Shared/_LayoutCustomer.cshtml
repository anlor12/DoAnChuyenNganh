                    <span class="badge bg-danger text-white" style="font-size: 9px;">Gọi ngay</span>

                </a>



                <!-- TRA CỨU SIZE THÔNG MINH -->

                <div class="border rounded-3 p-2 mb-2 bg-light">

                    <div class="d-flex justify-content-between align-items-center" onclick="toggleSizeCalc()" style="cursor: pointer;">

