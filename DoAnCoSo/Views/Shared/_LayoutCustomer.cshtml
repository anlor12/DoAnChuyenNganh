    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>



    <script>

        /* ===== NAVBAR SCROLL EFFECT ===== */

        (function () {

            var nav = document.getElementById('mainNav');

            window.addEventListener('scroll', function () {

                if (window.scrollY > 20) {

                    nav.classList.add('scrolled');

                } else {

                    nav.classList.remove('scrolled');

                }

            }, { passive: true });

        })();



        /* ===== HERO LOADED CLASS ===== */

        window.addEventListener('load', function () {

            var hero = document.querySelector('.hero');

            if (hero) hero.classList.add('loaded');

        });



        /* ===== PROMOTIONAL SLIDER ===== */

        (function () {

            var slides = document.querySelectorAll('.promo-slide');

            var prevBtn = document.getElementById('promoPrevBtn');

            var nextBtn = document.getElementById('promoNextBtn');

            var wrapper = document.getElementById('promoBarWrapper');

            var currentIndex = 0;

            var slideInterval = null;

            var intervalDuration = 4000; // 4 seconds



            if (slides.length === 0) return;



            function showSlide(index) {

                slides.forEach(function (slide, i) {

                    if (i === index) {

                        slide.classList.add('active');

                    } else {

                        slide.classList.remove('active');

                    }

                });

            }



            function nextSlide() {

                currentIndex = (currentIndex + 1) % slides.length;

                showSlide(currentIndex);

            }



            function prevSlide() {

                currentIndex = (currentIndex - 1 + slides.length) % slides.length;

                showSlide(currentIndex);

            }



            function startAutoPlay() {

                if (slideInterval) clearInterval(slideInterval);

                slideInterval = setInterval(nextSlide, intervalDuration);

            }



            function stopAutoPlay() {

                if (slideInterval) clearInterval(slideInterval);

            }



            // Event Listeners

            if (prevBtn) {

                prevBtn.addEventListener('click', function () {

                    prevSlide();

                    startAutoPlay(); // restart timer

                });

            }



            if (nextBtn) {

                nextBtn.addEventListener('click', function () {

                    nextSlide();

                    startAutoPlay(); // restart timer

                });

            }



            if (wrapper) {

                wrapper.addEventListener('mouseenter', stopAutoPlay);

                wrapper.addEventListener('mouseleave', startAutoPlay);

            }



            // Start first slide and autoplay

            showSlide(currentIndex);

            startAutoPlay();



            // Copy promo code logic

            var copyBtn = document.getElementById('btnCopyPromoCode');

            if (copyBtn) {

                copyBtn.addEventListener('click', function (e) {

                    e.preventDefault();

                    var code = copyBtn.getAttribute('data-code') || "NEW10";

                    navigator.clipboard.writeText(code).then(function () {

                        // Use existing system showCartToast function

                        if (typeof showCartToast === 'function') {

                            showCartToast('Đã sao chép mã giảm giá ' + code + ' vào bộ nhớ tạm!', true);

                        } else {

                            alert('Đã sao chép mã giảm giá ' + code + '!');

                        }

                    }).catch(function (err) {

                        console.error('Không thể sao chép: ', err);

                    });

                });

            }

        })();



        /* ===== CART TOAST ===== */

        function showCartToast(message, isSuccess = true) {

            var toastEl = document.getElementById('cartToast');

            if (!toastEl) return;

            var toastMessage = document.getElementById('toastMessage');

            var toastIcon = document.getElementById('toastIcon');

            toastMessage.textContent = message;

            if (isSuccess) {

                toastEl.className = 'toast align-items-center text-white bg-dark border-0';

                toastIcon.innerHTML = '<i class="fas fa-check-circle text-success" style="font-size:1.1rem;"></i>';

            } else {

                toastEl.className = 'toast align-items-center text-white bg-danger border-0';

                toastIcon.innerHTML = '<i class="fas fa-exclamation-circle" style="font-size:1.1rem;"></i>';

            }

            var toast = new bootstrap.Toast(toastEl, { delay: 3000 });

            toast.show();

        }



        function updateCartBadge(count) {

            var globalBadge = document.getElementById('globalCartCountBadge');

            if (globalBadge) {

                globalBadge.textContent = count > 0 ? count : '0';

                if (count > 0) {

                    globalBadge.classList.remove('d-none');

                    globalBadge.style.display = '';

                } else {

                    globalBadge.classList.add('d-none');

                }

            }

            var cartBtn = document.querySelector('a[href="/Cart"]');

            if (cartBtn) {

                var badges = cartBtn.querySelectorAll('.cart-count, .cart-badge-count-custom');

                badges.forEach(function (b) {

                    b.textContent = count > 0 ? count : '';

                    b.style.display = count > 0 ? '' : 'none';

                });

            }

        }



        /* ===== GLOBAL ADD TO CART FUNCTION ===== */

        window.addToCart = function (productId, variantId) {

            var dataPayload = { soLuong: 1 };

            if (variantId && variantId > 0) {

                dataPayload.maBienThe = variantId;

            } else if (productId && productId > 0) {

                dataPayload.maSanPham = productId;

            }



            $.ajax({

                url: '/Cart/AddToCart',

                type: 'POST',

                data: dataPayload,

                headers: { 'X-Requested-With': 'XMLHttpRequest' },

                success: function (response) {

                    if (response.success) {

                        showCartToast(response.message || 'Đã thêm sản phẩm vào giỏ hàng!', true);

                        updateCartBadge(response.cartCount);

                    } else {

                        if (response.redirectUrl) {

                            showCartToast((response.message || 'Vui lòng đăng nhập.') + ' Đang chuyển hướng...', false);

                            setTimeout(function () { window.location.href = response.redirectUrl; }, 1200);

                        } else {

                            showCartToast(response.message || 'Không thể thêm sản phẩm.', false);

                        }

                    }

                },

                error: function () {

                    showCartToast('Đã xảy ra lỗi khi kết nối máy chủ.', false);

                }

            });

        };



        /* ===== QUICK ADD TO CART ===== */

        $(document).on('click', '.quick-add-to-cart, .fs-quick-cart', function (e) {

            e.preventDefault();

            e.stopPropagation();

            var variantId = $(this).data('variant-id');

            var productId = $(this).data('product-id');

            if (!variantId && !productId) return;

            var $btn = $(this);

            var originalHtml = $btn.html();

            $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i>');

            

            var dataPayload = { soLuong: 1 };

            if (variantId && variantId > 0) dataPayload.maBienThe = variantId;

            else if (productId && productId > 0) dataPayload.maSanPham = productId;



            $.ajax({

                url: '/Cart/AddToCart',

                type: 'POST',

                data: dataPayload,

                headers: { 'X-Requested-With': 'XMLHttpRequest' },

                success: function (response) {

                    $btn.prop('disabled', false).html(originalHtml);

                    if (response.success) {

                        showCartToast(response.message, true);

                        updateCartBadge(response.cartCount);

                    } else {

                        if (response.redirectUrl) {

                            showCartToast(response.message + ' Đang chuyển hướng...', false);

                            setTimeout(function () { window.location.href = response.redirectUrl; }, 1500);

                        } else {

                            showCartToast(response.message, false);

                        }

                    }

                },

                error: function () {

                    $btn.prop('disabled', false).html(originalHtml);

                    showCartToast('Đã xảy ra lỗi khi thêm vào giỏ hàng.', false);

                }

            });

        });



        /* ===== USER DROPDOWN ===== */

        function toggleUserMenu(e) {

            if (e) {

                e.preventDefault();

                e.stopPropagation();

            }

            var menu = document.getElementById('navUserMenu');

            var chevron = document.getElementById('navChevron');

            if (!menu) return;

            menu.classList.toggle('show');

            if (chevron) chevron.classList.toggle('open');

        }



        document.addEventListener('click', function (e) {

            var dropdown = document.getElementById('navUserDropdown');

            if (dropdown && !dropdown.contains(e.target)) {

                var menu = document.getElementById('navUserMenu');

                var chevron = document.getElementById('navChevron');

                if (menu) menu.classList.remove('show');

                if (chevron) chevron.classList.remove('open');

            }

        });



        /* ===== SCROLL REVEAL ===== */

        (function () {

            var observer = new IntersectionObserver(function (entries) {

                entries.forEach(function (entry) {

                    if (entry.isIntersecting) {

                        entry.target.style.opacity = '1';

                        entry.target.style.transform = 'translateY(0)';

                        observer.unobserve(entry.target);

                    }

                });

            }, { threshold: 0.08 });



            document.querySelectorAll('.product-card-balen, .product-card').forEach(function (el) {

                el.style.opacity = '0';

                el.style.transform = 'translateY(24px)';

                el.style.transition = 'opacity 0.5s ease, transform 0.5s ease';

                observer.observe(el);

            });

        })();



        /* ===== SCROLL TO TOP EVENT ===== */

        var scrollTopBtn = document.getElementById('scrollToTopBtn');

        if (scrollTopBtn) {

            scrollTopBtn.addEventListener('click', function () {

                window.scrollTo({ top: 0, behavior: 'smooth' });

            });

        }



        /* ===== AI CHATBOT & VISUAL SEARCH LOGIC ===== */

        var chatHistory = [

            {

                role: "model",

                parts: [{ text: "Dạ em chào Anh/Chị! Em là Chuyên viên tư vấn phong cách của Fashion Store. Em có thể hỗ trợ Anh/Chị chọn size chuẩn, phối đồ thời trang hoặc giải đáp chính sách mua sắm ạ!" }]

            }

        ];

        var chatImageBase64 = "";



        // Gửi câu hỏi nhanh từ Quick Prompt Chips (với guard chống gửi trùng lặp khi AI đang trả lời)

        function sendQuickPrompt(promptText) {

            var typingIndicator = document.getElementById("typingIndicator");

            if (typingIndicator) return;

            var input = document.getElementById("chatInputText");

            if (input) {

                input.value = promptText;

                sendChatMessage();

            }

        }



        // Toggle chat window

        function toggleChatWindow() {

            var win = document.getElementById("chatbotWindow");

            if (win) {

                var isOpening = win.classList.contains("d-none");

                win.classList.toggle("d-none");

                if (isOpening) {

                    var supportCard = document.getElementById("supportPopupCard");

                    var supportIcon = document.getElementById("supportIcon");

                    if (supportCard && supportCard.style.display !== "none") {

                        supportCard.style.display = "none";

                        if (supportIcon) supportIcon.className = "fas fa-headset";

                    }

                    var body = document.getElementById("chatbotBody");

                    if (body) body.scrollTop = body.scrollHeight;

                }

            }

        }



        // Preview attached image in chat

        function previewChatImage(input) {

            if (input.files && input.files[0]) {

                var reader = new FileReader();

                reader.onload = function (e) {

                    chatImageBase64 = e.target.result;

                    document.getElementById("chatImagePreview").src = chatImageBase64;

                    document.getElementById("chatImagePreviewArea").classList.remove("d-none");

                };

                reader.readAsDataURL(input.files[0]);

            }

        }



        // Remove attached image

        function removeChatImage() {

            chatImageBase64 = "";

            document.getElementById("chatImageInput").value = "";

            document.getElementById("chatImagePreviewArea").classList.add("d-none");

        }



        // Handle Enter key inside chatbot input

        function handleChatKeyPress(e) {

            if (e.key === "Enter") {

                sendChatMessage();

            }

        }



        // Helper: Escape HTML special characters to prevent DOM XSS injection

        function escapeHtml(str) {

            if (!str) return "";

            return String(str)

                .replace(/&/g, "&amp;")

                .replace(/</g, "&lt;")

                .replace(/>/g, "&gt;")

                .replace(/"/g, "&quot;")

                .replace(/'/g, "&#39;");

        }



        // Render danh sách thẻ sản phẩm trực tiếp từ response DTO

        function renderProductCards(products, parentDiv) {

            if (!products || products.length === 0) return;

            var container = document.createElement("div");

            container.className = "chat-products-container";

            var html = '<div class="chat-products-title"><i class="fas fa-shopping-bag"></i> G&#7906;I &#221; S&#7842;N PH&#7848;M T&#7914; SHOP</div><div class="chat-products-list">';

            products.forEach(function (p) {

                var safeId = encodeURIComponent(p.maSanPham || '');

                var safeName = escapeHtml(p.tenSanPham || '');

                var safeCat = escapeHtml(p.loaiSanPham || 'Th&#7901;i trang');

                var safeImg = escapeHtml(p.hinhAnh || '/images/no-image.png');

                var priceFormatted = (p.gia || 0).toLocaleString('vi-VN');

                html += '<a href="/SanPham/Details/' + safeId + '" class="chat-product-item">' +

                    '<div class="chat-product-img"><img src="' + safeImg + '" alt="' + safeName + '" onerror="this.onerror=null;this.src=\'/images/no-image.png\';" /></div>' +

                    '<div class="chat-product-info">' +

                        '<div class="chat-product-cat">' + safeCat + '</div>' +

                        '<h6 class="chat-product-name" title="' + safeName + '">' + safeName + '</h6>' +

                        '<div class="chat-product-price">' + priceFormatted + ' &#273;</div>' +

                    '</div>' +

                    '<div class="chat-product-action">Xem</div>' +

                '</a>';

            });

            html += '</div>';

            container.innerHTML = html;

            parentDiv.appendChild(container);

            var body = document.getElementById("chatbotBody");

            if (body) body.scrollTop = body.scrollHeight;

        }



        // Append message to chat body (hỗ trợ trực tiếp tham số products từ backend)

        function appendChatMessage(sender, text, base64Img = "", products = null) {

            var body = document.getElementById("chatbotBody");

            if (!body) return;



            var msgDiv = document.createElement("div");

            msgDiv.className = "chat-message " + sender;



            if (base64Img) {

                var img = document.createElement("img");

                img.src = base64Img;

                img.className = "chat-message-image img-fluid rounded";

                msgDiv.appendChild(img);

            }



            var cleanText = text;

            var productIdsStr = null;



            if (text && sender === "bot") {

                // Trích xuất toàn bộ product IDs từ tất cả các tag [RECOMMEND: ...] xuất hiện trong văn bản

                var recommendRegex = /\[RECOMMEND:\s*([0-9\s,\-_]+)\]/gi;

                var match;

                var idParts = [];

                while ((match = recommendRegex.exec(text)) !== null) {

                    if (match[1]) idParts.push(match[1]);

                }

                if (idParts.length > 0) {

                    productIdsStr = idParts.join(",");

                }

                // Xóa sạch toàn bộ các tag [RECOMMEND: ...] khỏi văn bản hiển thị cho người dùng

                cleanText = text.replace(/\[RECOMMEND:\s*([0-9\s,\-_]+)\]/gi, "").trim();

            }



            if (cleanText) {

                var txt = document.createElement("span");

                txt.textContent = cleanText;

                msgDiv.appendChild(txt);

            }



            body.appendChild(msgDiv);

            body.scrollTop = body.scrollHeight;



            // Nếu đã có sẵn mảng sản phẩm từ response backend, hiển thị ngay

            if (products && products.length > 0) {

                renderProductCards(products, msgDiv);

            }

            // Ngược lại, nếu trong nội dung văn bản có tag [RECOMMEND: ...], fetch qua API

            else if (productIdsStr) {

                renderChatProducts(productIdsStr, msgDiv);

            }

        }



        // Fetch and render recommended products inline in chat message bubble

        function renderChatProducts(idsStr, parentDiv) {

            // Build products container

            var container = document.createElement("div");

            container.className = "chat-products-container";

            container.innerHTML = `

                <div class="chat-products-title">

                    <i class="fas fa-shopping-bag"></i> G&#7906;I &#221; S&#7842;N PH&#7848;M T&#7914; SHOP

                </div>

                <div class="chat-products-list">

                    <div class="text-center p-2 text-muted small">

                        <i class="fas fa-spinner fa-spin me-1"></i> &#272;ang t&#7843;i s&#7843;n ph&#7849;m...

                    </div>

                </div>

            `;

            parentDiv.appendChild(container);

            

            var listDiv = container.querySelector(".chat-products-list");

            var body = document.getElementById("chatbotBody");

            if (body) body.scrollTop = body.scrollHeight;



            $.ajax({

                url: "/api/Ai/GetProductsByIds",

                type: "GET",

                data: { ids: idsStr },

                success: function (res) {

                    if (res.success && res.products && res.products.length > 0) {

                        var html = "";

                        res.products.forEach(function (p) {

                            var safeId = encodeURIComponent(p.maSanPham || '');

                            var safeName = escapeHtml(p.tenSanPham || '');

                            var safeCat = escapeHtml(p.loaiSanPham || 'Th&#7901;i trang');

                            var safeImg = escapeHtml(p.hinhAnh || '/images/no-image.png');

                            var priceFormatted = (p.gia || 0).toLocaleString('vi-VN');

                            html += '<a href="/SanPham/Details/' + safeId + '" class="chat-product-item">' +

                                '<div class="chat-product-img"><img src="' + safeImg + '" alt="' + safeName + '" onerror="this.onerror=null;this.src=\'/images/no-image.png\';" /></div>' +

                                '<div class="chat-product-info">' +

                                    '<div class="chat-product-cat">' + safeCat + '</div>' +

                                    '<h6 class="chat-product-name" title="' + safeName + '">' + safeName + '</h6>' +

                                    '<div class="chat-product-price">' + priceFormatted + ' &#273;</div>' +

                                '</div>' +

                                '<div class="chat-product-action">Xem</div>' +

                            '</a>';

                        });

                        listDiv.innerHTML = html;

                    } else {

                        container.remove();

                    }

                    if (body) body.scrollTop = body.scrollHeight;

                },

                error: function () {

                    container.remove();

                }

            });

        }



        // Show/hide typing indicator

        function toggleTypingIndicator(show) {

            var body = document.getElementById("chatbotBody");

            if (!body) return;



            var existing = document.getElementById("typingIndicator");

            if (show) {

                if (!existing) {

                    var ind = document.createElement("div");

                    ind.className = "chat-typing-indicator";

                    ind.id = "typingIndicator";

                    ind.innerHTML = "<span></span><span></span><span></span>";

                    body.appendChild(ind);

                }

            } else {

                if (existing) {

                    existing.remove();

                }

            }



            // Vô hiệu hóa nút gửi và các gợi ý nhanh (chips) khi đang đợi phản hồi từ AI

            var sendBtn = document.querySelector(".btn-send-chat");

            if (sendBtn) {

                sendBtn.disabled = show;

                sendBtn.style.pointerEvents = show ? "none" : "";

                sendBtn.style.opacity = show ? "0.6" : "";

            }

            var chips = document.querySelectorAll(".chat-chip");

            chips.forEach(function (c) {

                c.disabled = show;

                c.style.pointerEvents = show ? "none" : "";

                c.style.opacity = show ? "0.6" : "";

            });



            body.scrollTop = body.scrollHeight;

        }



        // Send chat message

        function sendChatMessage() {

            var typingIndicator = document.getElementById("typingIndicator");

            if (typingIndicator) return;

            var input = document.getElementById("chatInputText");

            var prompt = input.value.trim();

            if (!prompt && !chatImageBase64) return;



            // Clear input and remove preview

            input.value = "";

            var currentImg = chatImageBase64;

            removeChatImage();



            // Append user message to UI

            appendChatMessage("user", prompt, currentImg);



            // Show AI typing

            toggleTypingIndicator(true);



            if (currentImg) {

                // Call Multimodal Chat API

                $.ajax({

                    url: "/api/Ai/ChatImage",

                    type: "POST",

                    contentType: "application/json",

                    data: JSON.stringify({ prompt: prompt || "Hãy tư vấn hình ảnh này giúp tôi.", base64Image: currentImg }),

                    success: function (res) {

                        toggleTypingIndicator(false);

                        if (res.success) {

                            appendChatMessage("bot", res.reply, "", res.products);

                            // Sync model response into history

                            chatHistory.push({ role: "user", parts: [{ text: prompt || "Tải lên hình ảnh sản phẩm" }] });

                            chatHistory.push({ role: "model", parts: [{ text: res.reply }] });

                        } else {

                            appendChatMessage("bot", "Lỗi: " + res.error);

                        }

                    },

                    error: function (xhr) {

                        toggleTypingIndicator(false);

                        appendChatMessage("bot", "Đã xảy ra lỗi khi kết nối với máy chủ AI.");

                    }

                });

            } else {

                // Call normal Text Chat API

                chatHistory.push({ role: "user", parts: [{ text: prompt }] });

                $.ajax({

                    url: "/api/Ai/Chat",

                    type: "POST",

                    contentType: "application/json",

                    data: JSON.stringify(chatHistory),

                    success: function (res) {

                        toggleTypingIndicator(false);

                        if (res.success) {

                            appendChatMessage("bot", res.reply, "", res.products);

                            chatHistory.push({ role: "model", parts: [{ text: res.reply }] });

                        } else {

                            appendChatMessage("bot", "Lỗi: " + res.error);

                            chatHistory.pop(); // Remove last user prompt since it failed

                        }

                    },

                    error: function (xhr) {

                        toggleTypingIndicator(false);

                        appendChatMessage("bot", "Đã xảy ra lỗi khi kết nối với máy chủ AI.");

                        chatHistory.pop();

                    }

                });

            }

        }



        // Visual Search Logic

        $(document).ready(function () {

            // Camera search button click

            $("#visualSearchBtn").on("click", function (e) {

                e.preventDefault();

                $("#visualSearchInput").click();

            });



            // Input file change handler for Visual Search

            $("#visualSearchInput").on("change", function () {

                if (this.files && this.files[0]) {

                    var file = this.files[0];

                    var reader = new FileReader();

                    reader.onload = function (e) {

                        var base64Data = e.target.result;

                        

                        // Show scanning overlay

                        $("#scannedImagePreview").attr("src", base64Data);

                        $("#scannerOverlay").removeClass("d-none");



                        // Call Visual Search API

                        $.ajax({

                            url: "/api/Ai/VisualSearch",

                            type: "POST",

                            contentType: "application/json",

                            data: JSON.stringify({ base64Image: base64Data }),

                            success: function (res) {

                                $("#scannerOverlay").addClass("d-none");

                                $("#visualSearchInput").val(""); // reset



                                if (res.success) {

                                    // Populate Tags

                                    var tagsHtml = "";

                                    if (res.keywords && res.keywords.length > 0) {

                                        res.keywords.forEach(function (kw) {

                                            tagsHtml += '<span class="badge visual-search-tag-badge">' + kw + '</span> ';

                                        });

                                    }

                                    $("#visualSearchTags").html(tagsHtml || '<span class="text-muted small">Không nhận dạng được từ khóa</span>');



                                    // Populate Products

                                    var prodsHtml = "";

                                    if (res.products && res.products.length > 0) {

                                        res.products.forEach(function (p) {

                                            prodsHtml += `

                                                <div class="col-md-3 col-sm-6">

                                                    <div class="product-card border h-100 d-flex flex-column" onclick="window.location.href='/SanPham/Details/${p.maSanPham}'">

                                                        <div class="product-card-img-wrap" style="aspect-ratio:3/4; overflow:hidden;">

                                                            <img src="${p.hinhAnh}" alt="${p.tenSanPham}" style="width:100%; height:100%; object-fit:cover;" />

                                                        </div>

                                                        <div class="product-card-body p-3 flex-grow-1">

                                                            <small class="text-muted d-block uppercase" style="font-size:9px; letter-spacing:1px;">${p.loaiSanPham}</small>

                                                            <h6 class="fw-bold mt-1 text-truncate" style="font-size:12px;" title="${p.tenSanPham}">${p.tenSanPham}</h6>

                                                            <div class="fw-bold mt-2 text-danger" style="font-size:13px;">${p.gia.toLocaleString('vi-VN')} ₫</div>

                                                        </div>

                                                        <div class="p-3 pt-0">

                                                            <a href="/SanPham/Details/${p.maSanPham}" class="btn btn-outline-dark btn-sm rounded-0 w-100" style="font-size:10px; font-weight:700; text-transform:uppercase;">Chi tiết</a>

                                                        </div>

                                                    </div>

                                                </div>

                                            `;

                                        });

                                    } else {

                                        prodsHtml = `

                                            <div class="col-12 text-center p-4">

                                                <i class="fas fa-box-open text-muted mb-3" style="font-size: 2.5rem;"></i>

                                                <p class="text-muted small">${res.message || "Không tìm thấy sản phẩm nào tương tự."}</p>

                                            </div>

                                        `;

                                    }

                                    $("#visualSearchProducts").html(prodsHtml);



                                    // Show Results Modal

                                    var modal = new bootstrap.Modal(document.getElementById("visualSearchResultModal"));

                                    modal.show();

                                } else {

                                    alert(res.message || "Đã xảy ra lỗi khi tìm kiếm bằng ảnh.");

                                }

                            },

                            error: function (xhr) {

                                $("#scannerOverlay").addClass("d-none");

                                $("#visualSearchInput").val(""); // reset

                                alert("Có lỗi xảy ra khi gọi API tìm kiếm hình ảnh.");

                            }

                        });

                    };

                    reader.readAsDataURL(file);

                }

            });

        });



        // Mobile Navigation Drawer Controls

        function toggleMobileDrawer(open) {

            var drawer = document.getElementById("mobileNavDrawer");

            var backdrop = document.getElementById("mobileNavBackdrop");

            if (open) {

                drawer.classList.add("active");

                backdrop.classList.add("active");

                document.body.style.overflow = "hidden";

            } else {

                drawer.classList.remove("active");

                backdrop.classList.remove("active");

                document.body.style.overflow = "";

            }

        }



        function toggleMobileSubmenu(btn) {

            var submenu = btn.closest(".mobile-menu-item").querySelector(".mobile-submenu");

            if (submenu) {

                submenu.classList.toggle("open");

                btn.classList.toggle("open");

            }

        }



        function openVisualSearchFromMobile() {

            toggleMobileDrawer(false);

            $("#visualSearchInput").click();

        }



        function openMobileSearchFocus() {

            toggleMobileDrawer(true);

            setTimeout(function () {

                var input = document.getElementById("mobileSearchInputBox");

                if (input) input.focus();

            }, 350);

        }

    </script>



