        }

        .khampha-banner-link img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

    </style>

</head>

<body>



    <!-- ANNOUNCEMENT BAR (UPGRADED PROMO SLIDER) -->

    <div class="announcement-bar-wrapper" id="promoBarWrapper">

        <button class="promo-nav-btn prev-btn" id="promoPrevBtn" aria-label="Khuyến mãi trước">

            <i class="fas fa-chevron-left"></i>

        </button>

        <div class="announcement-bar-slider" id="promoSlider">

            <!-- Slide 1 -->

            <div class="promo-slide active">

                <span class="promo-text">🚚 Miễn phí vận chuyển toàn quốc cho đơn hàng từ 500.000đ</span>

                <a href="/SanPham" class="promo-btn btn-bounce">Mua ngay <i class="fas fa-shopping-bag"></i></a>

            </div>

            <!-- Slide 2 -->

            <div class="promo-slide">

                <span class="promo-text">🔥 Đăng ký thành viên mới - Nhận ngay mã giảm 10%: <strong class="promo-code">NEW10</strong></span>

                <button class="promo-btn btn-glow" id="btnCopyPromoCode" data-code="NEW10">Sao chép mã <i class="fas fa-copy"></i></button>

            </div>

            <!-- Slide 3 -->

            <div class="promo-slide">

                <span class="promo-text">⚡ Chương trình đồng giá hè săn deal hot chỉ từ 199.000đ</span>

                <a href="/SanPham?sapXep=moi_nhat" class="promo-btn btn-gradient">Săn Deal <i class="fas fa-fire"></i></a>

            </div>

        </div>

        <button class="promo-nav-btn next-btn" id="promoNextBtn" aria-label="Khuyến mãi tiếp theo">

            <i class="fas fa-chevron-right"></i>

        </button>

    </div>



    <!-- NAVBAR -->

    <nav class="navbar-balenciaga" id="mainNav">

        <div class="nav-inner">



            <!-- Mobile Hamburger Button -->

            <button class="nav-mobile-toggle d-flex d-lg-none" id="btnMobileMenuToggle" type="button" aria-label="Mở menu" onclick="toggleMobileDrawer(true)">

                <i class="fas fa-bars"></i>

            </button>



            <!-- Logo -->

            <a class="nav-brand" asp-controller="Home" asp-action="Index" style="display: flex; align-items: center; text-decoration: none; margin-right: 32px;">

                <img src="/images/fashionstore/logo.svg" alt="FASHION STORE" style="height: 24px; width: auto;" />

            </a>



            <!-- Nav links -->

            <ul class="nav-links-adidas d-none d-lg-flex" style="white-space: nowrap; flex-wrap: nowrap;">

                <li><a href="/SanPham?sapXep=moi_nhat">HÀNG MỚI VỀ</a></li>

                @{

                    var aoParent = categories.FirstOrDefault(c => c.TenLoaiSanPham == "Áo");

                    var quanParent = categories.FirstOrDefault(c => c.TenLoaiSanPham == "Quần");

                    var phuKienParent = categories.FirstOrDefault(c => c.TenLoaiSanPham == "Phụ Kiện");



                    var subAoList = aoParent != null 

                        ? categories.Where(c => c.MaLoaiCha == aoParent.MaLoaiSanPham).OrderBy(c => c.TenLoaiSanPham).ToList()

                        : new List<DoAnCoSo.Models.LoaiSanPham>();



                    var subQuanList = quanParent != null 

                        ? categories.Where(c => c.MaLoaiCha == quanParent.MaLoaiSanPham).OrderBy(c => c.TenLoaiSanPham).ToList()

                        : new List<DoAnCoSo.Models.LoaiSanPham>();



                    var giayParent = categories.FirstOrDefault(c => c.TenLoaiSanPham == "Giày");

                    var subGiayList = giayParent != null 

                        ? categories.Where(c => c.MaLoaiCha == giayParent.MaLoaiSanPham).OrderBy(c => c.TenLoaiSanPham).ToList()

                        : new List<DoAnCoSo.Models.LoaiSanPham>();



                    var subPhuKienKhacList = phuKienParent != null 

                        ? categories.Where(c => c.MaLoaiCha == phuKienParent.MaLoaiSanPham && c.TenLoaiSanPham != "Giày").OrderBy(c => c.TenLoaiSanPham).ToList()

                        : new List<DoAnCoSo.Models.LoaiSanPham>();

                }

                <!-- Dropdown Áo (Thiết kế: 5 mục như trước + Banner FASHION | ÁO) -->

                <li class="nav-item-dropdown">

                    <a href="/SanPham?maLoai=@(aoParent?.MaLoaiSanPham)" class="nav-dropdown-toggle">

                        ÁO <i class="fas fa-chevron-down" style="font-size: 8px; margin-left: 3px; transition: transform 0.25s ease;"></i>

                    </a>

                    <div class="nav-dropdown-ao-panel">

                        <!-- Danh mục 5 mục như trước bên trái -->

                        <div class="ao-dropdown-links">

                            <a href="/SanPham?maLoai=@(aoParent?.MaLoaiSanPham)" class="ao-link-item ao-link-all">

                                <i class="fas fa-layer-group me-1 text-primary"></i> Tất cả sản phẩm Áo

                            </a>

                            @foreach (var cat in subAoList)

                            {

                                <a href="/SanPham?maLoai=@cat.MaLoaiSanPham" class="ao-link-item">

                                    @cat.TenLoaiSanPham

                                </a>

                            }

                        </div>



                        <!-- Banner FASHION | ÁO bên phải -->

                        <div class="ao-dropdown-banner">

                            <a href="/SanPham?maLoai=@(aoParent?.MaLoaiSanPham)" class="ao-banner-link" title="Xem tất cả bộ sưu tập Áo FASHION">

                                <img src="/images/fashionstore/mega_menu_ao_banner.png" alt="FASHION | ÁO" />

                            </a>

                        </div>

                    </div>

                </li>

                <!-- Dropdown Quần (Thiết kế: Danh mục + Banner FASHION | QUẦN giống như Áo) -->

                <li class="nav-item-dropdown">

                    <a href="/SanPham?maLoai=@(quanParent?.MaLoaiSanPham)" class="nav-dropdown-toggle">

                        QUẦN <i class="fas fa-chevron-down" style="font-size: 8px; margin-left: 3px; transition: transform 0.25s ease;"></i>

                    </a>

                    <div class="nav-dropdown-quan-panel">

                        <!-- Danh mục Quần bên trái -->

                        <div class="quan-dropdown-links">

                            <a href="/SanPham?maLoai=@(quanParent?.MaLoaiSanPham)" class="quan-link-item quan-link-all">

                                <i class="fas fa-layer-group me-1 text-primary"></i> Tất cả sản phẩm Quần

                            </a>

                            @foreach (var cat in subQuanList)

                            {

                                <a href="/SanPham?maLoai=@cat.MaLoaiSanPham" class="quan-link-item">

                                    @cat.TenLoaiSanPham

                                </a>

                            }

                        </div>



                        <!-- Banner FASHION | QUẦN bên phải -->

                        <div class="quan-dropdown-banner">

                            <a href="/SanPham?maLoai=@(quanParent?.MaLoaiSanPham)" class="quan-banner-link" title="Xem tất cả bộ sưu tập Quần FASHION">

                                <img src="/images/fashionstore/mega_menu_quan_banner.png" alt="FASHION | QUẦN" />

                            </a>

                        </div>

                    </div>

                </li>

                <!-- Dropdown Phụ Kiện (Thiết kế: Giày Nam + Phụ Kiện Khác + Banner FASHION | PHỤ KIỆN) -->

                <li class="nav-item-dropdown">

                    <a href="/SanPham?maLoai=@(phuKienParent?.MaLoaiSanPham)" class="nav-dropdown-toggle">

                        PHỤ KIỆN <i class="fas fa-chevron-down" style="font-size: 8px; margin-left: 3px; transition: transform 0.25s ease;"></i>

                    </a>

                    <div class="nav-dropdown-phukien-panel">

                        <!-- Danh mục Phụ Kiện bên trái -->

                        <div class="phukien-dropdown-links">

                            <a href="/SanPham?maLoai=@(phuKienParent?.MaLoaiSanPham)" class="phukien-link-item phukien-link-all">

                                <i class="fas fa-layer-group me-1 text-primary"></i> Tất cả Phụ Kiện

                            </a>

