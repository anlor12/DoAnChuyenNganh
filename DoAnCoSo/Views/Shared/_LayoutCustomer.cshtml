        <!-- LAUNCHER BUTTON (GỘP HỖ TRỢ & ZALO) -->

        <button type="button" onclick="toggleSupportWidget()" id="supportLauncherBtn" class="fashion-support-launcher shadow" title="Hỗ trợ &amp; Zalo">

            <i class="fas fa-headset" id="supportIcon"></i>

            <span class="support-zalo-badge">Z</span>

            <span class="support-tooltip">Hỗ Trợ &amp; Zalo</span>

        </button>

