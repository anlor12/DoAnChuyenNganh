    <script>

        function toggleSupportWidget() {

            var card = document.getElementById("supportPopupCard");

            var icon = document.getElementById("supportIcon");

            if (card.style.display === "none" || card.style.display === "") {

                var chatWin = document.getElementById("chatbotWindow");

                if (chatWin && !chatWin.classList.contains("d-none")) {

                    chatWin.classList.add("d-none");

                }

                card.style.display = "block";

                icon.className = "fas fa-times";

            } else {

                card.style.display = "none";

                icon.className = "fas fa-headset";

            }

        }



        function toggleSizeCalc() {

            var box = document.getElementById("sizeCalcBox");

            var chev = document.getElementById("sizeCalcChevron");

            if (box.style.display === "none") {

                box.style.display = "block";

                chev.className = "fas fa-chevron-up text-muted small";

            } else {

                box.style.display = "none";

                chev.className = "fas fa-chevron-down text-muted small";

            }

        }



        function calcQuickSize() {

            var h = parseFloat(document.getElementById("scHeight").value) || 170;

            var w = parseFloat(document.getElementById("scWeight").value) || 60;

            var res = document.getElementById("scResult");



            var size = "M";

            if (w < 55) size = "S (Form ôm gọn)";

            else if (w >= 55 && w < 65) size = "M (Vừa vặn)";

            else if (w >= 65 && w < 74) size = "L (Thoải mái)";

            else if (w >= 74 && w < 84) size = "XL (Rộng rãi)";

            else size = "XXL (Ngoại cỡ)";



            res.style.display = "block";

            res.innerHTML = '<span class="text-success"><i class="fas fa-check-circle me-1"></i>Size phù hợp nhất: <strong>' + size + '</strong></span>';

        }



        function checkQuickOrder() {

            var id = document.getElementById("quickOrderId").value.trim();

            if (!id) {

                alert("Vui lòng nhập mã đơn hàng cần tra cứu.");

                return;

            }

            window.location.href = "/KhachHangs/ChiTietDonHang/" + id;

        }



        // Click outside to close support popup

        document.addEventListener('click', function (e) {

            var supportWidget = document.getElementById('fashionSupportWidget');

            var card = document.getElementById('supportPopupCard');

            var icon = document.getElementById('supportIcon');

            if (supportWidget && card && card.style.display === 'block') {

                if (!supportWidget.contains(e.target)) {

                    card.style.display = 'none';

                    if (icon) icon.className = 'fas fa-headset';

                }

            }

        });

    </script>



