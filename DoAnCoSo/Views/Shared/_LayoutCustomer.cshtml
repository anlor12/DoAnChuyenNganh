@inject DoAnCoSo.Data.ApplicationDbContext DbContext

@{

    var zaloConfig = DbContext.CauHinhHeThongs.FirstOrDefault(x => x.Key == "Zalo_Link");

    var zaloLink = zaloConfig?.Value ?? "https://zalo.me/0901234567";

    if (!string.IsNullOrEmpty(zaloLink) && !zaloLink.StartsWith("http") && System.Text.RegularExpressions.Regex.IsMatch(zaloLink, @"^[0-9]+$"))

    {

        zaloLink = "https://zalo.me/" + zaloLink;

    }

    var categories = DbContext.LoaiSanPhams.OrderBy(x => x.MaLoaiSanPham).ToList();

    var userSession = Context.Session.GetString("AdminUser");

    var vaiTro = Context.Session.GetString("VaiTro");

    int cartCount = 0;

    if (!string.IsNullOrEmpty(userSession))

    {

        var u = Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions.Include(DbContext.TaiKhoans, t => t.NguoiDung).FirstOrDefault(t => t.TenDangNhap == userSession);

        if (u?.NguoiDung != null)

        {

            var c = Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions.Include(DbContext.GioHangs, g => g.ChiTietGioHangs).FirstOrDefault(g => g.MaNguoiDung == u.NguoiDung.MaNguoiDung);

            if (c != null && c.ChiTietGioHangs != null)

            {

                cartCount = c.ChiTietGioHangs.Sum(x => x.SoLuong);

            }

        }

    }

}

<!DOCTYPE html>

<html lang="vi">

<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

