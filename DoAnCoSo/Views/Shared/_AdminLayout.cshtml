@inject DoAnCoSo.Data.ApplicationDbContext _db
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var adminUser = Context.Session.GetString("AdminUser") ?? "admin • Quản trị viên";
    var userRole = Context.Session.GetString("VaiTro") ?? "Quản Trị Viên Hệ Thống";
    var avatarLetter = !string.IsNullOrEmpty(adminUser) ? adminUser.Substring(0, 1).ToUpper() : "A";

    int pendingOrders = _db.DonHangs.Count(o => o.TrangThaiDonHang == "Chờ xác nhận");
    int totalProds = _db.SanPhams.Count();

    var isDashboardActive = controller == "Home";
    var isOrdersActive = controller == "DonHangs" || controller == "ChiTietDonHangs";
    var isCatalogActive = controller == "SanPhams" || controller == "BienTheSanPhams" || controller == "LoaiSanPhams" || controller == "KhoHangs";
    var isMarketingActive = controller == "KhuyenMais" || controller == "Vip" || controller == "Marketing" || controller == "NguoiDungs" || controller == "DanhGias";
    var isCmsActive = controller == "BaiViets" || controller == "BoSuuTaps" || (controller == "CauHinhs" && action == "GioiThieu");
    var isSettingsActive = (controller == "CauHinhs" && action != "GioiThieu") || controller == "AuditLogs";
}

<!DOCTYPE html>
<html lang="vi" data-theme="v22-mint">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — FASHION STORE Admin OS</title>

    <!-- Bootstrap 5 CSS + Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">

    <!-- Lucide Icons CDN -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <!-- Legacy Stylesheet first, then Master Editorial Stylesheet -->
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-v22.css" asp-append-version="true" />
    <style>
        /* Critical inline image, grid & stationary sidebar guards */
        .v22-card-media { position: relative !important; width: 100% !important; height: 200px !important; max-height: 200px !important; border-radius: 16px !important; overflow: hidden !important; background: #f1f5f9; flex-shrink: 0 !important; }
        .v22-card-media img, .v22-img-cover { width: 100% !important; height: 100% !important; max-width: 100% !important; max-height: 100% !important; object-fit: cover !important; object-position: center top; display: block !important; }
        .v22-thumb { width: 46px !important; height: 46px !important; min-width: 46px !important; max-width: 46px !important; min-height: 46px !important; max-height: 46px !important; border-radius: 12px !important; overflow: hidden !important; object-fit: cover !important; border: 1px solid rgba(12,50,38,0.08); background: #f1f5f9; flex-shrink: 0 !important; display: inline-flex !important; align-items: center; justify-content: center; }
        .v22-thumb img { width: 100% !important; height: 100% !important; max-width: 46px !important; max-height: 46px !important; object-fit: cover !important; display: block !important; }
        .v22-thumb-tall { width: 56px !important; height: 72px !important; min-width: 56px !important; max-width: 56px !important; min-height: 72px !important; max-height: 72px !important; border-radius: 12px !important; overflow: hidden !important; object-fit: cover !important; border: 1px solid rgba(12,50,38,0.08); background: #f1f5f9; flex-shrink: 0 !important; display: inline-flex !important; align-items: center; justify-content: center; }
        .v22-thumb-tall img { width: 100% !important; height: 100% !important; max-width: 56px !important; max-height: 72px !important; object-fit: cover !important; display: block !important; }
        @@media (min-width: 992px) {
            #v22AppFrame { height: calc(100vh - 36px) !important; max-height: calc(100vh - 36px) !important; overflow: hidden !important; }
            #v22Sidebar { position: sticky !important; top: 0 !important; height: 100% !important; max-height: 100% !important; flex-shrink: 0 !important; overflow-y: auto !important; }
            .v22-workspace-col { height: 100% !important; max-height: 100% !important; overflow-y: auto !important; overflow-x: hidden !important; padding-right: 6px; }
        }
    </style>
</head>
<body class="v22-body">

    <!-- ROUNDED APP SHELL FRAME -->
    <div id="v22AppFrame">

        <!-- ==================== LEFT: FLOATING FOREST PILL SIDEBAR (#0A291F) ==================== -->
        <aside id="v22Sidebar">
            <div>
                <!-- Brand Logo + Pill Mode Toggle -->
                <div class="d-flex align-items-center justify-content-between px-1 mb-4">
                    <div class="d-flex align-items-center gap-2.5 overflow-hidden">
                        <button type="button" onclick="toggleSidebarMode()" title="Thu gọn / Mở rộng Sidebar" class="btn p-0 rounded-circle text-white font-display fw-bold d-flex align-items-center justify-content-center flex-shrink-0" style="width: 38px; height: 38px; background: rgba(255, 255, 255, 0.12); border: 1px solid rgba(255, 255, 255, 0.2);">
                            //
                        </button>
                        <div class="sb-label leading-tight">
                            <div class="font-display fw-bold text-white d-flex align-items-center gap-1.5" style="font-size: 13.5px;">
                                FASHION STORE
                            </div>
                            <div class="font-mono text-white-50" style="font-size: 10px;">Admin OS • Storefront</div>
                        </div>
                    </div>

                    <button type="button" onclick="toggleSidebarMode()" title="Thu gọn / Mở rộng Sidebar" class="sb-collapse-btn btn p-0 rounded-circle text-white-50 d-flex align-items-center justify-content-center" style="width: 26px; height: 26px; background: rgba(255, 255, 255, 0.08); font-size: 11px;">
                        «
                    </button>
                </div>

                <!-- 5 CONSOLIDATED MODULES (Matches mã demo.html 100% without duplicates) -->
                <nav class="d-flex flex-column gap-2.5">
                    <!-- 1. TỔNG QUAN -->
                    <div>
                        <div class="sb-section-head font-mono text-uppercase text-white-50 px-2 mb-1" style="font-size: 10px; letter-spacing: 0.5px;">1. Tổng quan</div>
                        <a asp-controller="Home" asp-action="Dashboard" class="sb-item @(isDashboardActive ? "active" : "")">
                            <span class="d-flex align-items-center gap-2.5">
                                <i class="bi bi-grid-1x2-fill"></i>
                                <span class="sb-label">Bảng điều khiển</span>
                            </span>
                            <span class="sb-tooltip">Bảng điều khiển &amp; Thống kê</span>
                        </a>
                    </div>

                    <!-- 2. BÁN HÀNG & KHO -->
                    <div>
                        <div class="sb-section-head font-mono text-uppercase text-white-50 px-2 mb-1" style="font-size: 10px; letter-spacing: 0.5px;">2. Bán hàng &amp; Kho</div>
                        <div class="d-flex flex-column gap-1">
                            <a asp-controller="DonHangs" asp-action="Index" class="sb-item @(isOrdersActive ? "active" : "")">
                                <span class="d-flex align-items-center gap-2.5">
                                    <i class="bi bi-bag-check-fill"></i>
                                    <span class="sb-label">Quản lý đơn hàng</span>
                                </span>
                                @if (pendingOrders > 0)
                                {
                                    <span class="sb-badge font-mono badge rounded-pill text-white" style="background: #E07A5F; font-size: 9.5px;">@pendingOrders chờ</span>
                                }
                                <span class="sb-tooltip">Quản lý đơn hàng &amp; Thanh toán</span>
                            </a>
                            <a asp-controller="SanPhams" asp-action="Index" class="sb-item @(isCatalogActive ? "active" : "")">
                                <span class="d-flex align-items-center gap-2.5">
                                    <i class="bi bi-tags-fill"></i>
                                    <span class="sb-label">Sản phẩm &amp; Kho</span>
                                </span>
                                <span class="sb-badge font-mono badge rounded-pill" style="background: rgba(52, 211, 153, 0.2); color: #6ee7b7; font-size: 9.5px;">@totalProds</span>
                                <span class="sb-tooltip">Sản phẩm (@totalProds) • Biến thể • Danh mục • Kho</span>
                            </a>
                        </div>
                    </div>

                    <!-- 3. KHÁCH HÀNG & AI -->
                    <div>
                        <div class="sb-section-head font-mono text-uppercase text-white-50 px-2 mb-1" style="font-size: 10px; letter-spacing: 0.5px;">3. Khách hàng &amp; AI</div>
                        <div class="d-flex flex-column gap-1">
                            <a asp-controller="KhuyenMais" asp-action="Index" class="sb-item @(isMarketingActive && !(controller == "Marketing" && action == "AbandonedCarts") ? "active" : "")">
                                <span class="d-flex align-items-center gap-2.5">
                                    <i class="bi bi-stars"></i>
                                    <span class="sb-label">Tiếp thị, VIP &amp; AI</span>
                                </span>
                                <span class="sb-badge font-mono badge rounded-pill" style="background: rgba(251, 191, 36, 0.22); color: #fcd34d; font-size: 9.5px;">11 VIP</span>
                                <span class="sb-tooltip">Khuyến mãi • 11 Bậc VIP • Loyalty • Khách hàng • Đánh giá AI</span>
                            </a>
                            <a asp-controller="Marketing" asp-action="AbandonedCarts" class="sb-item @(controller == "Marketing" && action == "AbandonedCarts" ? "active" : "")">
                                <span class="d-flex align-items-center gap-2.5">
                                    <i class="bi bi-cart-x-fill"></i>
                                    <span class="sb-label">Giải cứu giỏ hàng</span>
                                </span>
                                <span class="sb-badge font-mono badge rounded-pill" style="background: rgba(224, 122, 95, 0.25); color: #f4a28c; font-size: 9.5px;">Email</span>
                                <span class="sb-tooltip">Giải cứu giỏ hàng bị bỏ quên &amp; Gửi Voucher Email</span>
                            </a>
                        </div>
                    </div>

                    <!-- 4. NỘI DUNG (CMS) -->
                    <div>
                        <div class="sb-section-head font-mono text-uppercase text-white-50 px-2 mb-1" style="font-size: 10px; letter-spacing: 0.5px;">4. Nội dung (CMS)</div>
                        <a asp-controller="BoSuuTaps" asp-action="Index" class="sb-item @(isCmsActive ? "active" : "")">
                            <span class="d-flex align-items-center gap-2.5">
                                <i class="bi bi-images"></i>
                                <span class="sb-label">Lookbook &amp; Nội dung</span>
                            </span>
                            <span class="sb-badge font-mono badge rounded-pill bg-white bg-opacity-10 text-white-50" style="font-size: 9.5px;">CMS</span>
                            <span class="sb-tooltip">Bộ sưu tập Lookbook • Bài viết • Trang Giới thiệu</span>
                        </a>
                    </div>

                    <!-- 5. CÀI ĐẶT & BẢO MẬT -->
                    <div>
                        <div class="sb-section-head font-mono text-uppercase text-white-50 px-2 mb-1" style="font-size: 10px; letter-spacing: 0.5px;">5. Cài đặt &amp; Bảo mật</div>
                        <a asp-controller="CauHinhs" asp-action="Index" class="sb-item @(isSettingsActive ? "active" : "")">
                            <span class="d-flex align-items-center gap-2.5">
                                <i class="bi bi-key-fill"></i>
                                <span class="sb-label">API Keys &amp; Audit Log</span>
                            </span>
                            <span class="sb-badge font-mono badge rounded-pill" style="background: rgba(52, 211, 153, 0.22); color: #6ee7b7; font-size: 9.5px;">24/7</span>
                            <span class="sb-tooltip">Gemini API • Decart VTON API • Zalo CSKH • Audit Logs</span>
                        </a>
                    </div>
                </nav>
            </div>

            <!-- BOTTOM USER AVATAR & LIVE AI STATUS -->
            <div class="pt-3 border-top border-white border-opacity-10 d-flex flex-column gap-2">
                <a asp-controller="CauHinhs" asp-action="Index" class="text-decoration-none p-2 rounded-3 d-flex align-items-center justify-content-between" style="background: rgba(255,255,255,0.06); transition: all 0.2s;" title="Trạng thái Google Gemini AI & Decart Live VTON">
                    <div class="d-flex align-items-center gap-2">
                        <span class="rounded-circle bg-success" style="width: 8px; height: 8px;"></span>
                        <div class="sb-footer-text leading-tight text-white">
                            <div style="font-size: 11px; font-weight: 700;">Gemini + Decart 3D</div>
                            <div class="font-mono" style="font-size: 9.5px; color: #6ee7b7;">API Keys Connected</div>
                        </div>
                    </div>
                    <span class="sb-footer-text font-mono" style="font-size: 10px; color: #6ee7b7;">14ms</span>
                </a>

                <div class="p-2 rounded-3 bg-black bg-opacity-25 d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle text-white fw-bold d-flex align-items-center justify-content-center flex-shrink-0" style="width: 32px; height: 32px; background: linear-gradient(135deg, #E07A5F, #f59e0b); font-size: 12px;">
                            @avatarLetter
                        </div>
                        <div class="sb-footer-text text-white leading-tight">
                            <div class="text-truncate" style="font-size: 11px; font-weight: 700; max-width: 120px;">@adminUser</div>
                            <div class="text-white-50 text-truncate" style="font-size: 9.5px; max-width: 120px;">@userRole</div>
                        </div>
                    </div>
                    <div class="sb-footer-text d-flex align-items-center gap-1">
                        <a href="/" class="btn btn-sm p-1 text-white-50" title="Về trang chủ"><i class="bi bi-house-door"></i></a>
                        <a href="/Auth/Logout" class="btn btn-sm p-1 text-danger" title="Đăng xuất"><i class="bi bi-box-arrow-right"></i></a>
                    </div>
                </div>
            </div>
        </aside>

        <!-- ==================== RIGHT & CENTER: MAIN WORKSPACE ==================== -->
        <div class="v22-workspace-col flex-grow-1 min-w-0 d-flex flex-column gap-3">

            <!-- TOP HEADER BAR (Matches mã demo.html) -->
            <header class="d-flex flex-wrap align-items-center justify-content-between gap-3 px-1">
                <!-- Left: Pill Toggle + Quick Search -->
                <div class="d-flex align-items-center gap-2.5 flex-grow-1" style="min-width: 260px;">
                    <button type="button" onclick="toggleSidebarMode()" class="v22-btn-secondary py-2 px-3" title="Thu gọn / Mở rộng Pill Sidebar">
                        <span>⇄</span>
                        <span class="d-none d-sm-inline">Pill Sidebar</span>
                    </button>

                    <form asp-controller="SanPhams" asp-action="Index" method="get" class="position-relative flex-grow-1 m-0" style="max-width: 440px;">
                        <i class="bi bi-search position-absolute top-50 translate-middle-y text-muted" style="left: 14px; font-size: 12px;"></i>
                        <input type="text" name="searchString" placeholder="Tìm nhanh trên hệ thống (#252, ORD-20261012-1, VIP15...)" class="v22-card w-100 py-2 border-0" style="padding-left: 36px; padding-right: 42px; border-radius: 16px !important; font-size: 12px; font-weight: 500; outline: none;" />
                        <span class="position-absolute top-50 translate-middle-y font-mono text-muted" style="right: 12px; font-size: 10px;">⌘K</span>
                    </form>
                </div>

                <!-- Right: Theme Switch + Storefront -->
                <div class="d-flex align-items-center gap-2">
                    <button type="button" onclick="toggleDarkLight()" class="v22-btn-secondary py-2 px-3" title="Chuyển đổi giao diện Sáng / Tối">
                        <span id="themeIcon">🌙</span>
                        <span class="d-none d-sm-inline">Sáng/Tối</span>
                    </button>

                    <a asp-controller="Home" asp-action="Index" class="v22-btn-primary py-2 px-3.5" style="border-radius: 16px;" title="Chuyển sang giao diện trang chủ bán hàng">
                        <i class="bi bi-shop"></i>
                        <span class="d-none d-sm-inline">Xem Cửa Hàng</span>
                    </a>
                </div>
            </header>

            <!-- MAIN WORKSPACE CONTENT BODY -->
            <main class="v22-main-content">
                @RenderBody()
            </main>

        </div>

    </div>

    <!-- FLOATING TOAST NOTIFICATION CONTAINER -->
    <div id="v22Toast">
        <span class="rounded-circle bg-success bg-opacity-25 text-success d-flex align-items-center justify-content-center" style="width: 18px; height: 18px; font-size: 11px;">✓</span>
        <span id="v22ToastMsg">Đã cập nhật hệ thống!</span>
    </div>

    <!-- Scripts -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/admin-v22.js" asp-append-version="true"></script>
    <script src="~/js/admin.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
