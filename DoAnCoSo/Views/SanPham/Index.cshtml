                    <h5 class="fw-bold">Chưa có thông số cơ thể!</h5>
                    <p class="text-muted small mx-auto" style="max-width: 450px;">
                        Để AI có thể tư vấn style và size chính xác nhất, vui lòng cập nhật thông tin chiều cao và cân nặng trong hồ sơ cá nhân của bạn.
                    </p>
                    <a href="/KhachHangs/Profile" class="btn btn-dark rounded-0 mt-2 px-4 py-2" style="font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:1px;">
                        Cập nhật hồ sơ số đo
                    </a>
                </div>

                <!-- Success State -->
                <div id="aiRecContent" class="d-none">
                    <!-- Body Stats Summary -->
                    <div class="p-3 bg-light border mb-4 d-flex justify-content-around align-items-center flex-wrap gap-2 text-center">
                        <div>
                            <small class="text-muted d-block text-uppercase" style="font-size:10px;">Giới tính</small>
                            <span class="fw-bold" id="aiRecGender" style="font-size:15px;">-</span>
                        </div>
                        <div class="vr d-none d-sm-block"></div>
                        <div>
                            <small class="text-muted d-block text-uppercase" style="font-size:10px;">Chiều cao</small>
                            <span class="fw-bold"><span id="aiRecHeight">-</span> cm</span>
                        </div>
                        <div class="vr d-none d-sm-block"></div>
                        <div>
                            <small class="text-muted d-block text-uppercase" style="font-size:10px;">Cân nặng</small>
                            <span class="fw-bold"><span id="aiRecWeight">-</span> kg</span>
                        </div>
                        <div class="vr d-none d-sm-block"></div>
                        <div>
                            <small class="text-muted d-block text-uppercase" style="font-size:10px;">Size gợi ý</small>
                            <span class="badge bg-dark rounded-0 px-3 py-2" id="aiRecSize" style="font-size:13px; font-weight:700;">-</span>
                        </div>
                    </div>

                    <!-- AI Advice -->
                    <div class="mb-4">
                        <h6 class="fw-bold border-bottom pb-2 mb-3 text-uppercase" style="font-size:12px; letter-spacing:1px; color:#555;">
                            <i class="fas fa-comment-alt text-dark me-2"></i>Lời khuyên thời trang AI
                        </h6>
                        <div class="p-3 border-start border-dark border-3 bg-white shadow-sm rounded-1" id="aiRecAdviceText" style="font-size:13.5px; line-height:1.6; color:#333; font-style:italic;">
                            -
                        </div>
                    </div>

                    <!-- Recommended Products -->
                    <div>
                        <h6 class="fw-bold border-bottom pb-2 mb-3 text-uppercase" style="font-size:12px; letter-spacing:1px; color:#555;">
                            <i class="fas fa-tags text-dark me-2"></i>Sản phẩm gợi ý cho vóc dáng của bạn
                        </h6>
                        <div class="row g-3" id="aiRecProductsList">
                            <!-- Populated by JS -->
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light rounded-0">
                <button type="button" class="btn btn-secondary btn-sm rounded-0" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Mobile sidebar toggle
    const sidebar = document.getElementById('filterSidebar');
    const toggle = document.getElementById('sidebarToggle');
    const overlay = document.getElementById('sidebarOverlay');

    if (toggle) {
        toggle.addEventListener('click', () => {
            sidebar.classList.toggle('open');
            overlay.classList.toggle('open');
        });
    }

    if (overlay) {
        overlay.addEventListener('click', () => {
            sidebar.classList.remove('open');
            overlay.classList.remove('open');
        });
    }

    // Countdown Timer - set end date to 7 days from now
    (function() {
        if (!document.getElementById('countDays')) return;
        const endDate = new Date();
        endDate.setDate(endDate.getDate() + 7);
        endDate.setHours(23, 59, 59, 0);

        function updateCountdown() {
            const now = new Date();
            const diff = endDate - now;

            if (diff <= 0) {
                document.getElementById('countDays').textContent = '00';
                document.getElementById('countHours').textContent = '00';
                document.getElementById('countMins').textContent = '00';
                document.getElementById('countSecs').textContent = '00';
                return;
            }

            const days = Math.floor(diff / (1000 * 60 * 60 * 24));
            const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
            const secs = Math.floor((diff % (1000 * 60)) / 1000);

            document.getElementById('countDays').textContent = String(days).padStart(2, '0');
            document.getElementById('countHours').textContent = String(hours).padStart(2, '0');
            document.getElementById('countMins').textContent = String(mins).padStart(2, '0');
            document.getElementById('countSecs').textContent = String(secs).padStart(2, '0');
        }

        updateCountdown();
        setInterval(updateCountdown, 1000);
    })();

    // ===== AI BODY RECOMMENDATION LOGIC =====
    $(document).ready(function () {
        $("#btnGetAiRec").on("click", function (e) {
            e.preventDefault();
            
            // Show modal and loading state
            var modal = new bootstrap.Modal(document.getElementById("aiRecModal"));
            modal.show();
            
            $("#aiRecLoading").removeClass("d-none");
            $("#aiRecUpdateProfile").addClass("d-none");
            $("#aiRecContent").addClass("d-none");
            
            // Call API
            $.ajax({
                url: "/api/Ai/BodyRecommendation",
                type: "POST",
                contentType: "application/json",
                success: function (res) {
                    $("#aiRecLoading").addClass("d-none");
                    
                    if (res.success) {
                        // Populate content
                        $("#aiRecGender").text(res.gender);
                        $("#aiRecHeight").text(res.height);
                        $("#aiRecWeight").text(res.weight);
                        $("#aiRecSize").text(res.recommendedSize);
                        $("#aiRecAdviceText").html(res.advice.replace(/\n/g, "<br>"));
                        
                        // Populate products
                        var html = "";
                        if (res.products && res.products.length > 0) {
                            res.products.forEach(function (p) {
                                html += `
                                    <div class="col-md-6">
                                        <div class="card h-100 border rounded-0 d-flex flex-row overflow-hidden shadow-sm" style="transition: transform 0.2s;">
                                            <div style="width: 100px; min-width: 100px; aspect-ratio: 3/4; overflow: hidden;">
                                                <img src="${p.hinhAnh}" alt="${p.tenSanPham}" style="width:100%; height:100%; object-fit:cover;" />
                                            </div>
                                            <div class="p-3 d-flex flex-column justify-content-between flex-grow-1" style="min-width:0;">
                                                <div>
                                                    <small class="text-muted d-block text-uppercase" style="font-size:9px; letter-spacing:0.5px;">${p.loaiSanPham}</small>
                                                    <h6 class="fw-bold text-truncate mb-1" style="font-size:12px;" title="${p.tenSanPham}">${p.tenSanPham}</h6>
                                                    <div class="fw-bold text-danger mb-2" style="font-size:12.5px;">${p.gia.toLocaleString('vi-VN')} ₫</div>
                                                    <div class="text-muted" style="font-size:11px; line-height:1.4; display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;" title="${p.reason}">
                                                        <strong>Lý do gợi ý:</strong> ${p.reason}
                                                    </div>
                                                </div>
                                                <div class="mt-2 text-end">
                                                    <a href="/SanPham/Details/${p.maSanPham}" class="btn btn-outline-dark btn-sm rounded-0 py-1 px-3" style="font-size:10px; font-weight:700; text-transform:uppercase;">Chi tiết</a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                `;
                            });
                        } else {
                            html = `
                                <div class="col-12 text-center p-4">
                                    <i class="fas fa-box-open text-muted mb-3" style="font-size: 2rem;"></i>
                                    <p class="text-muted small">Không tìm thấy sản phẩm nào phù hợp từ shop.</p>
                                </div>
                            `;
                        }
                        $("#aiRecProductsList").html(html);
                        $("#aiRecContent").removeClass("d-none");
                    } else if (res.needProfileUpdate) {
                        $("#aiRecUpdateProfile").removeClass("d-none");
                    } else {
                        alert(res.message || "Đã xảy ra lỗi khi lấy gợi ý.");
                        modal.hide();
                    }
                },
                error: function (xhr) {
                    $("#aiRecLoading").addClass("d-none");
                    alert(xhr.responseJSON?.message || "Đã xảy ra lỗi kết nối với máy chủ.");
                    modal.hide();
                }
            });
        });
    });

    /* ===== WISHLIST TOGGLE ===== */
    function getWishlist() {
        try {
            return JSON.parse(localStorage.getItem('fashion_wishlist') || '[]');
        } catch {
            return [];
        }
    }

    function toggleWishlist(e, productId, btn) {
        if (e) {
            e.preventDefault();
            e.stopPropagation();
        }
        var list = getWishlist();
        var idx = list.indexOf(productId);
        var icon = btn.querySelector('i');
        if (idx > -1) {
            list.splice(idx, 1);
            if (icon) {
                icon.className = 'far fa-heart text-secondary';
            }
            if (typeof showCartToast === 'function') {
                showCartToast('Đã xóa sản phẩm khỏi danh sách yêu thích.', true);
            }
        } else {
            list.push(productId);
            if (icon) {
                icon.className = 'fas fa-heart text-danger';
            }
            if (typeof showCartToast === 'function') {
                showCartToast('Đã lưu sản phẩm vào danh sách yêu thích!', true);
            }
        }
        localStorage.setItem('fashion_wishlist', JSON.stringify(list));
    }

    // Khởi tạo trạng thái icon Wishlist từ localStorage
    document.addEventListener('DOMContentLoaded', function () {
        var list = getWishlist();
        document.querySelectorAll('.wishlist-toggle-btn').forEach(function (btn) {
            var pid = parseInt(btn.getAttribute('data-product-id'));
            if (list.includes(pid)) {
                var icon = btn.querySelector('i');
                if (icon) icon.className = 'fas fa-heart text-danger';
            }
        });
    });
</script>
