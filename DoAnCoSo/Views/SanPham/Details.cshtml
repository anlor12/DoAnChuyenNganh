<!-- Modal Thử đồ ảo AI (Anywear Live Fitting) -->
@await Html.PartialAsync("_VirtualTryOnModal")

@section Scripts {
<script type="module" src="~/js/virtual-tryon.js" asp-append-version="true"></script>
<script>
    @{
        var scriptStockMap = ViewBag.StockMap as Dictionary<int, int> ?? new Dictionary<int, int>();
        var scriptFirstBt = Model.BienTheSanPhams?.FirstOrDefault();
        int scriptFirstStock = scriptFirstBt != null && scriptStockMap.ContainsKey(scriptFirstBt.MaBienThe) ? scriptStockMap[scriptFirstBt.MaBienThe] : 50;
    }
    var currentVariant = {
        id: @(scriptFirstBt != null ? scriptFirstBt.MaBienThe : 0),
        stock: @scriptFirstStock,
        size: '@(scriptFirstBt?.KichCo ?? "")',
        color: '@(scriptFirstBt?.MauSac ?? "")'
    };

    function selectVariant(el, variantId, stock, size, color) {
        document.querySelectorAll('.variant-option').forEach(function (v) { v.classList.remove('selected'); });
        el.classList.add('selected');
        document.getElementById('selectedVariant').value = variantId;
        currentVariant = { id: variantId, stock: stock, size: size, color: color };

        var addToCartBtn = document.getElementById('addToCartBtn');
        var outOfStockBtn = document.getElementById('outOfStockBtn');
        var qtyWrapper = document.getElementById('qtyWrapper');

        if (stock <= 0) {
            if (addToCartBtn) addToCartBtn.classList.add('d-none');
            if (outOfStockBtn) outOfStockBtn.classList.remove('d-none');
            if (qtyWrapper) qtyWrapper.style.display = 'none';
        } else {
            if (addToCartBtn) addToCartBtn.classList.remove('d-none');
            if (outOfStockBtn) outOfStockBtn.classList.add('d-none');
            if (qtyWrapper) qtyWrapper.style.display = '';
        }
    }

    function changeQty(delta) {
        var input = document.getElementById('soLuong');
        var val = parseInt(input.value) + delta;
        if (val < 1) val = 1;
        if (val > 99) val = 99;
        input.value = val;
    }

    $('#addToCartForm').on('submit', function (e) {
        e.preventDefault();
        var form = $(this);
        var submitBtn = form.find('#addToCartBtn');
        var originalHtml = submitBtn.html();
        submitBtn.prop('disabled', true).html('<span><i class="fas fa-spinner fa-spin me-2"></i>Đang xử lý...</span>');
        $.ajax({
            url: '/Cart/AddToCart',
            type: 'POST',
            data: form.serialize(),
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            success: function (response) {
                submitBtn.prop('disabled', false).html(originalHtml);
                if (response.success) {
                    showCartToast(response.message, true);
                    updateCartBadge(response.cartCount);
                } else {
                    if (response.redirectUrl) {
                        showCartToast(response.message + ' Đang chuyển hướng...', false);
                        setTimeout(function () { window.location.href = response.redirectUrl; }, 1500);
                    } else {
                        showCartToast(response.message, false);
                    }
                }
            },
            error: function () {
                submitBtn.prop('disabled', false).html(originalHtml);
                showCartToast('Đã xảy ra lỗi. Vui lòng thử lại.', false);
            }
        });
    });

    // Sticky Mobile Buy Bar scroll detection
    window.addEventListener('scroll', function () {
        var mainBuyBtn = document.getElementById('addToCartBtn');
        var stickyBar = document.getElementById('mobileStickyBuyBar');
        if (!mainBuyBtn || !stickyBar) return;

        var rect = mainBuyBtn.getBoundingClientRect();
        if (rect.bottom < 0) {
            stickyBar.classList.add('visible');
        } else {
            stickyBar.classList.remove('visible');
        }
    });

    function triggerMobileBuy() {
        var form = document.getElementById('addToCartForm');
        if (form) {
            $(form).submit();
        }
    }

    // Modal Viết đánh giá
    function openReviewModal() {
        var modalEl = document.getElementById('modalVietDanhGia');
        if (modalEl) {
            var myModal = new bootstrap.Modal(modalEl);
            myModal.show();
        }
    }

    function setStarRating(score) {
        document.getElementById('inputDiemDanhGia').value = score;
        var labels = {
            1: "Rất không hài lòng (1 sao)",
            2: "Chưa hài lòng (2 sao)",
            3: "Bình thường (3 sao)",
            4: "Hài lòng (4 sao)",
            5: "Tuyệt vời (5 sao)"
        };
        document.getElementById('starScoreLabel').innerText = labels[score] || (score + " sao");
        var stars = document.querySelectorAll('#starRatingSelect i');
        stars.forEach(function (star) {
            var s = parseInt(star.getAttribute('data-score'));
            if (s <= score) {
                star.classList.add('active');
            } else {
                star.classList.remove('active');
            }
        });
    }

    function previewReviewPhoto(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function (e) {
                document.getElementById('reviewPhotoImg').src = e.target.result;
                document.getElementById('reviewPhotoPreview').classList.remove('d-none');
            };
            reader.readAsDataURL(input.files[0]);
        }
    }

    function removeReviewPhoto() {
        document.getElementById('inputReviewPhoto').value = '';
        document.getElementById('reviewPhotoPreview').classList.add('d-none');
        document.getElementById('reviewPhotoImg').src = '';
    }

    function openReviewImage(src) {
        document.getElementById('modalPreviewReviewImg').src = src;
        var modalEl = document.getElementById('modalReviewImage');
        if (modalEl) {
            var myModal = new bootstrap.Modal(modalEl);
            myModal.show();
        }
    }

    // Back-in-Stock Alert Modal
    function openBackInStockModal() {
        var variantText = (currentVariant.size || '') + (currentVariant.color ? ' · ' + currentVariant.color : '');
        document.getElementById('modalVariantInfo').innerText = variantText || 'Mặc định';
        document.getElementById('backInStockContact').value = '';
        document.getElementById('backInStockError').classList.add('d-none');
        document.getElementById('backInStockSuccessAlert').classList.add('d-none');
        document.getElementById('btnSubmitBackInStock').disabled = false;

        var modalEl = document.getElementById('modalBaoCoHang');
        if (modalEl) {
            var myModal = new bootstrap.Modal(modalEl);
            myModal.show();
        }
    }

    function submitBackInStock() {
        var contact = document.getElementById('backInStockContact').value.trim();
        var errorEl = document.getElementById('backInStockError');
        if (!contact) {
            errorEl.classList.remove('d-none');
            return;
        }
        errorEl.classList.add('d-none');

        var btn = document.getElementById('btnSubmitBackInStock');
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Đang đăng ký...';

        $.ajax({
            url: '/SanPham/DangKyBaoCoHang',
            type: 'POST',
            data: {
                maSanPham: @Model.MaSanPham,
                maBienThe: currentVariant.id,
                lienHe: contact,
                size: currentVariant.size,
                mauSac: currentVariant.color
            },
            success: function (res) {
                if (res.success) {
                    document.getElementById('backInStockSuccessAlert').classList.remove('d-none');
                    btn.innerHTML = '<i class="fas fa-check me-1"></i> Đã đăng ký';
                    if (typeof showCartToast === 'function') {
                        showCartToast(res.message, true);
                    }
                    setTimeout(function () {
                        var modalEl = document.getElementById('modalBaoCoHang');
                        var modalInstance = bootstrap.Modal.getInstance(modalEl);
                        if (modalInstance) modalInstance.hide();
                    }, 2000);
                } else {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-paper-plane me-1"></i> Đăng ký thông báo';
                    alert(res.message || 'Đã có lỗi xảy ra.');
                }
            },
            error: function () {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-paper-plane me-1"></i> Đăng ký thông báo';
                alert('Không thể kết nối đến máy chủ. Vui lòng thử lại sau.');
            }
        });
    }

    function changeProductGalleryImage(src, el) {
        var mainImg = document.getElementById('product2DImage');
        if (mainImg) {
            mainImg.style.opacity = '0.35';
            setTimeout(function() {
                mainImg.src = src;
                mainImg.style.opacity = '1';
            }, 120);
        }
        document.querySelectorAll('.product-thumb-slot').forEach(function(t) {
            t.classList.remove('active-thumb');
            t.style.borderColor = 'transparent';
        });
        if (el) {
            el.classList.add('active-thumb');
            el.style.borderColor = '#000000';
        }
    }
</script>
}
